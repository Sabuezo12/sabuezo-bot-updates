CaveBotEditorButton < Button
  height: 20
  text-align: center

CaveBotSetProfileCheckBox < BotSwitch
  height: 20
  margin-top: 3

CaveBotDepotModeButton < BotSwitch
  height: 24
  margin-top: 4
  text-align: center

CaveBotDepotActionWindow < MainWindow
  text: Depot
  width: 320
  height: 235
  padding: 18

  Label
    id: description
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-align: center
    text-wrap: true
    text-auto-resize: true
    text: Select what this waypoint should do.

  CaveBotDepotModeButton
    id: deposit
    anchors.top: description.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    text: Deposit

  CaveBotDepotModeButton
    id: withdraw
    anchors.top: deposit.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text: Withdraw

  CaveBotDepotModeButton
    id: all
    anchors.top: withdraw.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text: Deposit + Withdraw

  Label
    id: preview
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: ok.top
    margin-bottom: 10
    height: 32
    text-align: center
    text-wrap: true
    text: -

  Button
    id: ok
    !text: tr('Ok')
    anchors.bottom: parent.bottom
    anchors.right: next.left
    margin-right: 10
    width: 60

  Button
    id: cancel
    !text: tr('Cancel')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 60

CaveBotSetProfileEditorWindow < MainWindow
  text: Set CaveBot profile
  width: 360
  height: 380
  padding: 18

  Label
    id: description
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-align: center
    text-wrap: true
    text-auto-resize: true
    text: Select one route, or select multiple to choose randomly.

  VerticalScrollBar
    id: profilesScroll
    anchors.top: description.bottom
    anchors.right: parent.right
    anchors.bottom: preview.top
    step: 20
    pixels-scroll: true
    margin-top: 8
    margin-bottom: 8

  ScrollablePanel
    id: profiles
    anchors.top: description.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: preview.top
    vertical-scrollbar: profilesScroll
    margin-top: 8
    margin-right: 12
    margin-bottom: 8
    padding-right: 2
    layout:
      type: verticalBox

  Label
    id: preview
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: ok.top
    margin-bottom: 10
    height: 34
    text-align: center
    text-wrap: true
    text: -

  Button
    id: ok
    !text: tr('Ok')
    anchors.bottom: parent.bottom
    anchors.right: next.left
    margin-right: 10
    width: 60

  Button
    id: cancel
    !text: tr('Cancel')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 60


CaveBotEditorPanel < Panel
  id: cavebotEditor
  visible: false
  layout:
    type: verticalBox
    fit-children: true
  
  Label
    id: pos
    text-align: center
    text: -
    
  Panel
    id: buttons
    margin-top: 2
    layout:
      type: grid
      cell-size: 78 20
      cell-spacing: 1
      num-columns: 2
      fit-children: true

  Label
    text: Double click on action from action list to edit it
    text-align: center
    text-auto-resize: true
    text-wrap: true
    margin-top: 3
    margin-left: 2
    margin-right: 2
