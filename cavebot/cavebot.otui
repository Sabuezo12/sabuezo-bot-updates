CaveBotAction < Label
  background-color: alpha
  text-offset: 2 0
  focusable: true

  $focus:
    background-color: #00000055


CaveBotPanel < Panel
  layout:
    type: verticalBox
    fit-children: true

  BotSwitch
    id: autoRecording
    text: Auto Recording
    margin-bottom: 2      

  Panel
    id: autoExplorer
    margin-bottom: 2
    layout:
      type: verticalBox
      fit-children: true

    BotSwitch
      id: enabled
      text: Auto Explorer
      margin-bottom: 2

    Panel
      id: statusRow
      height: 20

      BotTextEdit
        id: radiusEdit
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        width: 38

      Label
        text: Radio
        anchors.right: radiusEdit.left
        anchors.verticalCenter: radiusEdit.verticalCenter
        margin-right: 3

      Label
        id: statusLabel
        text: Off
        anchors.left: parent.left
        anchors.right: prev.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        margin-right: 3

    Panel
      id: optionsRow
      height: 20

      BotSwitch
        id: floorSwitch
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        width: 35

        $on:
          text: On

        $!on:
          text: Off

      Button
        id: resetButton
        text: Reset
        anchors.right: floorSwitch.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-right: 2
        width: 43

      Label
        text: Pisos
        anchors.left: parent.left
        anchors.right: resetButton.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        margin-right: 3

  HorizontalSeparator
    margin-top: 2
    margin-bottom: 1
    
  Panel
    id: listPanel
    height: 130
    margin-top: 2

    TextList
      id: list
      anchors.fill: parent
      vertical-scrollbar: listScrollbar
      margin-right: 15
      focusable: false
      auto-focus: first
      background-color: #585860
      
    VerticalScrollBar
      id: listScrollbar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      pixels-scroll: true
      step: 10  
    
  BotSwitch
    id: showEditor
    margin-top: 2
    
    $on:
      text: Hide waypoints editor
      
    $!on:
      text: Show waypoints editor

  BotSwitch
    id: showConfig
    margin-top: 2
    
    $on:
      text: Hide config
      
    $!on:
      text: Show config
