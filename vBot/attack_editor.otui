StudioLabel < Label
  font: verdana-11px-antialised
  text-align: left
  color: #e1e4e3
  phantom: true

StudioButton < Button
  font: verdana-11px-antialised
  height: 28
  $on:
    image-color: #dfdfdf
    color: #dcfffa

StudioAccentButton < StudioButton

StudioToggle < StudioButton
  $on:
    image-color: #5ba765
    color: #e0ffdc

StudioTab < StudioButton
  padding: 0
  UIWidget
    id: indicator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 8
    margin-bottom: 2
    height: 2
    background-color: #59c8bf
    phantom: true
    visible: false

StudioCheck < CheckBox
  font: verdana-11px-antialised
  height: 22
  color: #e1e4e3

StudioBox < FlatPanel
  padding: 0

StudioSpellBox < StudioBox
  image-color: #a6a6a6

StudioEdit < TextEdit
  color: #dce5e2
  selection-color: #ffffff
  selection-background-color: #477b72
  image-source: /images/ui/panel_flat
  image-border: 1

StudioNumber < Panel
  height: 26
  StudioButton
    id: minus
    anchors.left: parent.left
    anchors.top: parent.top
    width: 16
    height: 26
    padding: 0
    text: -
  StudioEdit
    id: input
    anchors.left: minus.right
    anchors.right: plus.left
    anchors.top: parent.top
    height: 26
    margin-left: 2
    margin-right: 2
    text-align: center
  StudioButton
    id: plus
    anchors.right: parent.right
    anchors.top: parent.top
    width: 16
    height: 26
    padding: 0
    text: +

StudioEntry < UIWidget
  height: 38
  focusable: true
  background-color: #17171788
  $hover:
    background-color: #393939bb
  $on:
    background-color: #3c3c3ccc
    border-width: 1
    border-color: #59bdb2
  StudioCheck
    id: enabled
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 10
    margin-top: 8
    width: 18
    height: 22
  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 36
    margin-top: 5
    width: 28
    height: 28
    phantom: true
  UIItem
    id: item
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 34
    margin-top: 3
    width: 32
    height: 32
    virtual: true
    phantom: true
    visible: false
  StudioLabel
    id: title
    anchors.left: parent.left
    anchors.right: minimum.left
    anchors.top: parent.top
    margin-left: 76
    margin-right: 8
    margin-top: 1
    height: 20
    font: sans-bold-16px
  StudioLabel
    id: words
    anchors.left: title.left
    anchors.right: title.right
    anchors.top: title.bottom
    height: 14
    color: #a4b3af
    font: verdana-9px
  StudioLabel
    id: minimum
    anchors.right: cooldown.left
    anchors.verticalCenter: parent.verticalCenter
    width: 42
    height: 20
    text-align: center
  StudioLabel
    id: cooldown
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 54
    height: 20
    text-align: center

