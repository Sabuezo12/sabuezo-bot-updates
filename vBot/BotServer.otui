BotServerTransportComboBoxPopupMenu < ComboBoxPopupMenu
BotServerTransportComboBoxPopupMenuButton < ComboBoxPopupMenuButton
BotServerTransportComboBox < ComboBox
  @onSetup: |
    self:addOption("Guild")
    self:addOption("Party")
    self:addOption("Extended Opcode")
    self:addOption("WebSocket")

BotServerData < Panel
  size: 340 76
  image-source: /images/ui/window
  image-border: 6
  padding: 3

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    !text: tr("BotServer Data")

  Label
    id: channelLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 23
    width: 88
    text-align: left
    text: Channel:
    margin-left: 6

  TextEdit
    id: Channel
    anchors.top: parent.top
    anchors.left: prev.right
    margin-top: 20
    width: 150
    margin-left: 5
    text-align: center

  Button
    id: Random
    anchors.left: prev.right
    anchors.top: prev.top
    anchors.right: parent.right
    text-align: center
    text: Randomize
    margin-left: 6
    margin-right: 6

  Label
    id: statusLabel
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-bottom: 4
    text-align: center
    text: Status:

  Label
    id: ServerStatus
    anchors.left: prev.right
    anchors.bottom: parent.bottom
    margin-left: 10
    width: 150
    margin-bottom: 4
    text-align: left

  Label
    id: Participants
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 20
    margin-right: 8
    margin-bottom: 4
    text-align: center

  UIWidget
    id: Members
    anchors.right: Participants.left
    anchors.bottom: parent.bottom
    size: 80 21
    text-align: center
    text: Members:

TransportPanel < Panel
  size: 340 82
  image-source: /images/ui/panel_flat
  image-border: 5
  padding: 3

  Label
    id: title
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    text: Game transport

  HorizontalSeparator
    id: sep
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  Label
    id: transportLabel
    anchors.top: sep.bottom
    anchors.left: parent.left
    margin-top: 7
    margin-left: 6
    width: 72
    text: Transport:

  BotServerTransportComboBox
    id: TransportMode
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 5
    width: 145

  Label
    id: guildChannelLabel
    anchors.top: TransportMode.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 6
    width: 38
    text: Guild:

  SpinBox
    id: GuildChannelId
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 4
    width: 48
    minimum: 0
    maximum: 65535
    step: 1

  Label
    id: gameChannelLabel
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 10
    width: 36
    text: Party:

  SpinBox
    id: GameChannelId
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 4
    width: 48
    minimum: 0
    maximum: 65535
    step: 1

  Label
    id: opcodeLabel
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 10
    text: Opcode:

  SpinBox
    id: ExtendedOpcode
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 4
    width: 50
    minimum: 0
    maximum: 255
    step: 1

FeaturePanel < Panel
  size: 340 112
  image-source: /images/ui/panel_flat
  image-border: 5
  padding: 3

  Label
    id: title
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    text: Features

  HorizontalSeparator
    id: sep
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  BotSwitch
    id: Feature1
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-left: 3
    margin-top: 5
    width: 54
    height: 21
    text: Mana

  BotSwitch
    id: Feature6
    anchors.top: sep.bottom
    anchors.left: Feature1.right
    margin-top: 5
    margin-left: 8
    width: 48
    height: 21
    text: Map

  BotSwitch
    id: Feature5
    anchors.top: sep.bottom
    anchors.left: Feature6.right
    margin-top: 5
    margin-left: 8
    width: 86
    height: 21
    text: Broadcast

  BotSwitch
    id: Feature7
    anchors.top: sep.bottom
    anchors.left: Feature5.right
    margin-top: 5
    margin-left: 8
    width: 64
    height: 21
    text: Exiva

  TextEdit
    id: broadcastText
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 3
    margin-bottom: 3
    margin-right: 80

  Button
    id: Broadcast
    anchors.top: prev.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-right: 3
    margin-left: 3
    height: 22
    text: Broadcast

BotServerExivaActivityRow < Panel
  height: 16

  Label
    id: Time
    anchors.left: parent.left
    anchors.top: parent.top
    width: 55
    height: 16
    font: verdana-11px-rounded

  Label
    id: Initiator
    anchors.left: Time.right
    anchors.top: parent.top
    margin-left: 4
    width: 129
    height: 16
    font: verdana-11px-rounded
    color: #9dd1ce

  Label
    id: Target
    anchors.left: Initiator.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 4
    height: 16
    font: verdana-11px-rounded

BotServerExivaActivity < Panel
  size: 340 134
  image-source: /images/ui/panel_flat
  image-border: 5
  padding: 3

  Label
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 6
    height: 17
    width: 160
    text: Exivas recientes

  Button
    id: Stop
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 6
    size: 108 20
    text: Parar (60 s)
    visible: false
    tooltip: Apaga Exiva Target/Last y pausa los exivas compartidos del grupo durante 60 segundos. Todos deben tener esta funcion instalada.

  Label
    id: Status
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-left: 6
    margin-right: 6
    height: 16
    font: verdana-11px-rounded
    text: Sin exivas registrados

  BotServerExivaActivityRow
    id: Headings
    anchors.top: Status.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 6
    margin-right: 6
    margin-top: 4

  BotServerExivaActivityRow
    id: Row1
    anchors.top: Headings.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 6
    margin-right: 6
    margin-top: 2

  BotServerExivaActivityRow
    id: Row2
    anchors.top: Row1.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 6
    margin-right: 6
    margin-top: 0

  BotServerExivaActivityRow
    id: Row3
    anchors.top: Row2.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 6
    margin-right: 6
    margin-top: 0

  BotServerExivaActivityRow
    id: Row4
    anchors.top: Row3.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 6
    margin-right: 6
    margin-top: 0

BotServerWindow < MainWindow
  !text: tr('BotServer')
  size: 370 516
  @onEscape: self:hide()

  BotServerData
    id: Data
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter

  TransportPanel
    id: Transport
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

  FeaturePanel
    id: Features
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

  BotServerExivaActivity
    id: ExivaActivity
    anchors.top: Features.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

  HorizontalSeparator
    id: separator
    anchors.right: parent.right
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    margin-bottom: 8

  Button
    id: closeButton
    !text: tr('Close')
    font: cipsoftFont
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 45 21
    margin-top: 15
    margin-right: 5

  BotSwitch
    id: enabled
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: parent.left
    margin-left: 5
    width: 125
    height: 21

    $!on:
      text: BotServer: OFF

    $on:
      text: BotServer: ON
