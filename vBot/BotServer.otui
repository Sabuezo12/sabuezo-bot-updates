    BotServerDashboardLabel
      id: Caption
      anchors.left: Icon.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      margin-right: 4
      text: Ver en mapa
      text-align: left

  BotServerSkinDanger
    id: Stop
    anchors.top: Locate.top
    anchors.right: parent.right
    margin-right: 24
    size: 158 24
    text: Parar exivas (60 s)
    visible: false
    tooltip: Solo lideres. Pausa de 60 segundos para los miembros que tienen esta funcion.

  BotServerIcon
    id: Leader
    anchors.left: Stop.right
    anchors.verticalCenter: Stop.verticalCenter
    size: 20 20
    image-source: botserver_assets/crown.png
    margin-left: 8
    visible: false

  BotServerDashboardLabel
    id: LeaderHint
    text: Control de parada exclusivo del lider
    anchors.top: Locate.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 14
    color: #a6b3bf

  HorizontalSeparator
    id: CurrentSeparator
    anchors.top: LeaderHint.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  BotServerDashboardLabel
    id: Status
    text: Sin exivas registrados
    anchors.top: CurrentSeparator.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 18

  BotServerExivaActivityRow
    id: Headings
    anchors.top: Status.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    image-source: botserver_assets/heading.png

  BotServerExivaActivityRow
    id: Row1
    anchors.top: Headings.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0

  BotServerExivaActivityRow
    id: Row2
    anchors.top: Row1.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0

  BotServerExivaActivityRow
    id: Row3
    anchors.top: Row2.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0

  BotServerExivaActivityRow
    id: Row4
    anchors.top: Row3.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0

  BotServerExivaActivityRow
    id: Row5
    anchors.top: Row4.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0

  BotServerExivaActivityRow
    id: Row6
    anchors.top: Row5.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0

  BotServerExivaActivityRow
    id: Row7
    anchors.top: Row6.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0

  BotServerExivaActivityRow
    id: Row8
    anchors.top: Row7.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 0

BotServerWindow < MainWindow
  text:
  size: 540 460
  font: sans-bold-16px
  image-source: botserver_assets/window.png
  image-border: 8
  image-clip: 0 0 64 64
  text-align: topLeft
  text-offset: 18 8
  padding-top: 8
  padding-left: 10
  padding-right: 10
  padding-bottom: 8
  @onEscape: self:hide()

  BotServerDashboardLabel
    id: Title
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.top: parent.top
    height: 22
    font: sans-bold-16px
    text: Navi By: Sabuezo

  BotServerSkinButton
    id: closeButton
    text: X
    anchors.right: parent.right
    anchors.top: parent.top
    size: 18 18
    tooltip: Cerrar Navi
    height: 18
    @onClick: self:getParent():hide()

  Panel
    id: Header
    anchors.top: Title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20

    BotServerIcon
      id: Dot
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 18 18
      image-source: botserver_assets/status-gray.png

    BotServerDashboardLabel
      id: Status
      text: Desconectado
      anchors.left: Dot.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      width: 100

    BotServerDashboardLabel
      id: Divider1
      text: |
      anchors.left: Status.right
      anchors.verticalCenter: parent.verticalCenter
      width: 18
      text-align: center
      color: #86939e

    BotServerDashboardLabel
      id: Members
      text: 0 jugadores
      anchors.left: Divider1.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      width: 94

    BotServerDashboardLabel
      id: Divider2
      text: |
      anchors.left: Members.right
      anchors.verticalCenter: parent.verticalCenter
      width: 18
      text-align: center
      color: #86939e

    BotServerDashboardLabel
      id: Channel
      text:
      anchors.left: Divider2.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8

  Panel
    id: Tabs
    anchors.top: Header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 24

    BotServerDashboardTab
      id: Companions
      anchors.left: parent.left
      anchors.top: parent.top
      width: 172
      text: Companeros (0)

    BotServerDashboardTab
      id: Exivas
      anchors.left: Companions.right
      anchors.top: parent.top
      margin-left: 4
      width: 164
      text: Exivas

    BotServerDashboardTab
      id: Connection
      anchors.left: Exivas.right
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 4
      text: Conexion

  BotServerCompanions
    id: MembersPage
    anchors.top: Tabs.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-top: 6
    margin-bottom: 4

  BotServerData
    id: Data
    anchors.top: Tabs.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    visible: false

  TransportPanel
    id: Transport
    anchors.top: Data.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    visible: false

  FeaturePanel
    id: Features
    anchors.top: Transport.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    visible: false

  BotServerDashboardLabel
    id: ConnectionNote
    text: Comparte HP, mana y posicion con el grupo. Mana controla su visualizacion sobre personajes. Mapa controla los marcadores. Todos deben usar el mismo canal.
    anchors.top: Features.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 42
    text-wrap: true
    visible: false

  BotServerExivaActivity
    id: ExivaActivity
    anchors.top: Tabs.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-top: 6
    margin-bottom: 4
    visible: false

  HorizontalSeparator
    id: separator
    anchors.right: parent.right
    anchors.left: parent.left
    anchors.bottom: enabled.top
    margin-bottom: 4

  BotServerSkinPower
    id: enabled
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    size: 142 24
    text:

    BotServerIcon
      id: Dot
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 14 14
      image-source: botserver_assets/status-green.png
      margin-left: 6

    BotServerDashboardLabel
      id: Caption
      anchors.left: Dot.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      margin-right: 4
      text: Navi: ON
