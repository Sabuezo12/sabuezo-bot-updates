BotServerSkinButton < Button
  font: verdana-11px-antialised
  color: #e4edf3
  height: 24
  padding: 0
  text-offset: 0 0
  image-source: botserver_assets/button.png
  image-clip: 0 0 96 36
  image-border: 6
  image-color: #ffffff
  opacity: 1
  $hover !disabled:
    image-source: botserver_assets/button-hover.png
    image-clip: 0 0 96 36
    image-color: #ffffff
  $pressed:
    image-source: botserver_assets/button-pressed.png
    image-clip: 0 0 96 36
    text-offset: 0 0
  $on:
    image-source: botserver_assets/tab-active.png
    image-clip: 0 0 96 36
    color: #effcff
  $disabled:
    image-source: botserver_assets/button.png
    image-clip: 0 0 96 36
    opacity: 0.45

BotServerSkinOpener < BotServerSkinButton
  height: 24

BotServerSkinIconButton < BotServerSkinButton
  text:
  text-offset: 0 0
  $pressed:
    text-offset: 0 0

BotServerSkinDanger < BotServerSkinButton
  image-source: botserver_assets/danger.png
  color: #ffb4a7
  $hover !disabled:
    image-source: botserver_assets/danger.png
    image-color: #ffd1cc
  $pressed:
    image-source: botserver_assets/danger.png
  $disabled:
    image-source: botserver_assets/danger.png

BotServerSkinPower < BotServerSkinButton
  $pressed:
    text-offset: 0 0
  $!on:
    image-source: botserver_assets/button.png
  $on:
    image-source: botserver_assets/power-on.png
    color: #f0fff2

BotServerSkinSwitch < BotServerSkinButton
  size: 64 24
  text:
  image-source: botserver_assets/switch-off.png
  image-clip: 0 0 64 24
  image-border: 0
  $hover !disabled:
    image-source: botserver_assets/switch-off.png
    image-clip: 0 0 64 24
  $pressed:
    image-source: botserver_assets/switch-off.png
    image-clip: 0 0 64 24
    text-offset: 0 0
  $on:
    image-source: botserver_assets/switch-on.png
    image-clip: 0 0 64 24
  $disabled:
    image-source: botserver_assets/switch-off.png
    image-clip: 0 0 64 24
    opacity: 0.45

  Label
    id: Caption
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 28
    size: 32 20
    text: OFF
    text-align: center
    font: verdana-11px-antialised
    color: #dce6ef
    phantom: true
    focusable: false

BotServerIcon < UIWidget
  size: 20 20
  phantom: true
  focusable: false

BotServerPreviewMarker < UIWidget
  size: 13 13
  phantom: false
  focusable: false
  visible: false

BotServerPreviewGuideDot < UIWidget
  size: 3 3
  phantom: true
  focusable: false
  visible: false

BotServerSkinCard < Panel
  image-source: botserver_assets/card.png
  image-border: 5
  padding: 4

BotServerDashboardLabel < Label
  font: verdana-11px-antialised
  color: #d9e4ed
  height: 18
  phantom: true

BotServerDashboardTab < BotServerSkinButton
  height: 24

BotServerMemberBar < Panel
  width: 102
  height: 20
  phantom: true

  UIWidget
    id: Frame
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 60 16
    image-source: botserver_assets/bar.png
    image-border: 3
    phantom: true

    UIWidget
      id: Fill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin: 3
      width: 1
      image-source: botserver_assets/hp-fill.png
      phantom: true

  BotServerDashboardLabel
    id: Value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 38
    text-align: center
    text: --

BotServerTransportComboBoxPopupMenu < ComboBoxPopupMenu
BotServerTransportComboBoxPopupMenuButton < ComboBoxPopupMenuButton
BotServerTransportComboBox < ComboBox
  @onSetup: |
    self:addOption("Guild")
    self:addOption("Party")
    self:addOption("Extended Opcode")
    self:addOption("WebSocket")

BotServerData < Panel
  size: 520 70
  image-source: botserver_assets/card.png
  image-border: 6
  padding: 3

  BotServerDashboardLabel
    id: titleLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    !text: tr("BotServer Data")

  BotServerDashboardLabel
    id: channelLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 23
    width: 88
    text-align: left
    text: Canal:
    margin-left: 6

  TextEdit
    id: Channel
    anchors.top: parent.top
    anchors.left: prev.right
    margin-top: 20
    width: 300
    margin-left: 5
    text-align: center

  BotServerSkinButton
    id: Random
    anchors.left: prev.right
    anchors.top: prev.top
    anchors.right: parent.right
    text-align: center
    text: Aleatorio
    margin-left: 6
    margin-right: 6

  BotServerDashboardLabel
    id: statusLabel
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-bottom: 4
    text-align: center
    text: Status:

  BotServerDashboardLabel
    id: ServerStatus
    anchors.left: prev.right
    anchors.bottom: parent.bottom
    margin-left: 10
    width: 150
    margin-bottom: 4
    text-align: left

  BotServerDashboardLabel
    id: Participants
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 20
    margin-right: 8
    margin-bottom: 4
    text-align: center

  UIWidget
    id: Members
    anchors.right: Participants.left
    anchors.bottom: parent.bottom
    size: 80 21
    text-align: center
    text: Miembros:

TransportPanel < Panel
  size: 520 106
  image-source: botserver_assets/card.png
  image-border: 5
  padding: 3

  BotServerDashboardLabel
    id: title
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    text: Transporte

  HorizontalSeparator
    id: sep
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  BotServerDashboardLabel
    id: transportLabel
    anchors.top: sep.bottom
    anchors.left: parent.left
    margin-top: 7
    margin-left: 6
    width: 72
    text: Transport:

  BotServerTransportComboBox
    id: TransportMode
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 5
    width: 145

  BotServerDashboardLabel
    id: guildChannelLabel
    anchors.top: TransportMode.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 6
    width: 38
    text: Guild:

  SpinBox
    id: GuildChannelId
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 4
    width: 48
    minimum: 0
    maximum: 65535
    step: 1

  BotServerDashboardLabel
    id: gameChannelLabel
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 10
    width: 36
    text: Party:

  SpinBox
    id: GameChannelId
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 4
    width: 48
    minimum: 0
    maximum: 65535
    step: 1

  BotServerDashboardLabel
    id: opcodeLabel
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 10
    text: Opcode:

  SpinBox
    id: ExtendedOpcode
    anchors.verticalCenter: prev.verticalCenter
    anchors.left: prev.right
    margin-left: 4
    width: 50
    minimum: 0
    maximum: 255
    step: 1

  BotServerDashboardLabel
    id: Hint
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 6
    margin-right: 6
    margin-bottom: 4
    height: 18
    color: #a8b6b8
    font: verdana-11px-antialised

FeaturePanel < Panel
  size: 520 98
  image-source: botserver_assets/card.png
  image-border: 5
  padding: 3

  BotServerDashboardLabel
    id: title
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    text: Funciones

  HorizontalSeparator
    id: sep
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  BotServerSkinButton
    id: Feature1
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-left: 3
    margin-top: 5
    width: 54
    height: 21
    text: Mana

  BotServerSkinButton
    id: Feature6
    anchors.top: sep.bottom
    anchors.left: Feature1.right
    margin-top: 5
    margin-left: 8
    width: 48
    height: 21
    text: Map

  BotServerSkinButton
    id: Feature5
    anchors.top: sep.bottom
    anchors.left: Feature6.right
    margin-top: 5
    margin-left: 8
    width: 86
    height: 21
    text: Broadcast

  BotServerSkinButton
    id: Feature7
    anchors.top: sep.bottom
    anchors.left: Feature5.right
    margin-top: 5
    margin-left: 8
    width: 64
    height: 21
    text: Exiva

  TextEdit
    id: broadcastText
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 3
    margin-bottom: 3
    margin-right: 80

  BotServerSkinButton
    id: Broadcast
    anchors.top: prev.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-right: 3
    margin-left: 3
    height: 22
    text: Broadcast

BotServerMemberRow < UIWidget
  height: 30
  focusable: true
  image-source: botserver_assets/row.png
  image-border: 4

  $hover:
    image-source: botserver_assets/row-hover.png

  $on:
    image-source: botserver_assets/row-selected.png

  BotServerIcon
    id: Dot
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 14 14
    image-source: botserver_assets/status-gray.png
    margin-left: 6

  BotServerDashboardLabel
    id: Name
    text:
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 28
    margin-top: 2
    width: 136
    height: 16

  BotServerIcon
    id: Leader
    anchors.left: parent.left
    anchors.verticalCenter: Name.verticalCenter
    size: 14 14
    image-source: botserver_assets/crown.png
    margin-left: 165
    visible: false

  BotServerDashboardLabel
    id: Freshness
    text:
    anchors.left: Name.left
    anchors.top: Name.bottom
    width: 152
    height: 12
    color: #a6b3bf

  UIWidget
    id: Favorite
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 181
    size: 18 18
    image-source: botserver_assets/star-outline.png
    focusable: true
    tooltip: Marcar o quitar favorito

    $hover:
      image-color: #fff2b6

  BotServerMemberBar
    id: Hp
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 206

  BotServerMemberBar
    id: Mana
    anchors.left: Hp.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  BotServerSkinIconButton
    id: Locate
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    size: 78 24
    tooltip: Ubicar a este companero solo en el mapa de Navi
    text:

    BotServerIcon
      id: Icon
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 12 16
      margin-left: 6
      image-source: botserver_assets/pin.png

    BotServerDashboardLabel
      id: Caption
      anchors.left: Icon.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      margin-right: 4
      text: Ubicar
      text-align: left

BotServerCompanions < Panel

  TextEdit
    id: Search
    anchors.left: parent.left
    anchors.top: parent.top
    width: 186
    height: 24
    placeholder: Buscar jugador
    tooltip: Buscar por nombre
    font: verdana-11px-antialised
    image-source: botserver_assets/input.png
    image-border: 5
    padding-left: 32
    padding-right: 6
    text-offset: 0 0
    color: #e4edf3

    BotServerIcon
      id: Icon
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 20 20
      image-source: botserver_assets/search.png
      margin-left: -25

  BotServerSkinIconButton
    id: Favorites
    anchors.left: Search.right
    anchors.top: Search.top
    margin-left: 4
    size: 96 24
    text:

    BotServerIcon
      id: Icon
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 16 16
      margin-left: 6
      image-source: botserver_assets/star-filled.png

    BotServerDashboardLabel
      id: Caption
      anchors.left: Icon.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      margin-right: 4
      text: Favoritos
      text-align: left

  BotServerSkinIconButton
    id: SameFloor
    anchors.left: Favorites.right
    anchors.top: Search.top
    margin-left: 4
    size: 100 24
    text:

    BotServerIcon
      id: Icon
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 16 16
      margin-left: 6
      image-source: botserver_assets/layers.png

    BotServerDashboardLabel
      id: Caption
      anchors.left: Icon.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      margin-right: 4
      text: Mismo piso
      text-align: left

  ComboBox
    id: Sort
    anchors.right: parent.right
    anchors.top: Search.top
    width: 126
    height: 24
    font: verdana-11px-antialised
    tooltip: Orden de la lista; datos recientes primero
    @onSetup: |
      self:addOption("Nombre")
      self:addOption("Menor HP")
      self:addOption("Menor mana")

  Panel
    id: Headings
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: Search.bottom
    margin-top: 4
    height: 20
    image-source: botserver_assets/heading.png
    image-border: 4

    BotServerDashboardLabel
      id: Player
      text: Jugador
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 16
      width: 180

    BotServerDashboardLabel
      id: Hp
      text: HP
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 206
      width: 102

    BotServerDashboardLabel
      id: Mana
      text: Mana
      anchors.left: Hp.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      width: 102

    BotServerDashboardLabel
      id: Map
      text: Mapa
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 16
      width: 78
      text-align: center

  ScrollablePanel
    id: List
    anchors.left: parent.left
    anchors.right: Scroll.left
    anchors.top: Headings.bottom
    anchors.bottom: Selected.top
    margin-top: 3
    margin-right: 4
    margin-bottom: 4
    vertical-scrollbar: Scroll
    layout:
      type: verticalBox
      spacing: 1

  VerticalScrollBar
    id: Scroll
    anchors.top: Headings.bottom
    anchors.bottom: Selected.top
    anchors.right: parent.right
    margin-top: 3
    margin-bottom: 4
    width: 12
    step: 31
    pixels-scroll: true

  BotServerDashboardLabel
    id: Empty
    text: Sin companeros para estos filtros
    anchors.top: List.top
    anchors.left: List.left
    anchors.right: List.right
    margin-top: 12
    height: 32
    text-align: center

  BotServerSkinCard
    id: Selected
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: Alerts.top
    margin-bottom: 4
    height: 60

    BotServerDashboardLabel
      id: Name
      text: Selecciona un companero
      anchors.left: parent.left
      anchors.top: parent.top
      width: 284
      height: 16

    BotServerDashboardLabel
      id: Position
      text: Posicion: -
      anchors.left: parent.left
      anchors.top: Name.bottom
      width: 352
      height: 14

    BotServerDashboardLabel
      id: Status
      text:
      anchors.left: Position.right
      anchors.top: Position.top
      width: 180
      height: 18
      visible: false

    BotServerSkinIconButton
      id: Locate
      anchors.left: parent.left
      anchors.top: Position.bottom
      size: 122 22
      height: 22
      text:

      BotServerIcon
        id: Icon
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 16 16
        margin-left: 6
        image-source: botserver_assets/crosshair.png

      BotServerDashboardLabel
        id: Caption
        anchors.left: Icon.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        margin-right: 4
        text: Centrar mapa
        text-align: left

    BotServerSkinButton
      id: PreviewToggle
      anchors.left: Locate.right
      anchors.top: Locate.top
      margin-left: 4
      size: 90 22
      height: 22
      text: Mini mapa
      tooltip: Desplegar o contraer el mapa grande dentro de Navi

    BotServerSkinButton
      id: TargetLocate
      anchors.left: PreviewToggle.right
      anchors.top: Locate.top
      margin-left: 4
      size: 88 22
      height: 22
      text: Punto exiva
      tooltip: Centrar el mapa de Navi en la posicion del exiveado
      enabled: false

    BotServerSkinButton
      id: ZoomOut
      anchors.left: TargetLocate.right
      anchors.top: Locate.top
      margin-left: 8
      size: 26 22
      height: 22
      text: -
      tooltip: Alejar mapa
      visible: false

    BotServerSkinButton
      id: ZoomIn
      anchors.left: ZoomOut.right
      anchors.top: Locate.top
      margin-left: 4
      size: 26 22
      height: 22
      text: +
      tooltip: Acercar mapa
      visible: false

    BotServerDashboardLabel
      id: MapInfo
      anchors.left: Name.right
      anchors.right: parent.right
      anchors.top: Name.top
      height: 16
      margin-left: 8
      text:
      phantom: false
      focusable: false
      visible: false

    UIMinimap
      id: Preview
      anchors.top: Locate.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 8
      phantom: false
      focusable: false
      draggable: false
      autowalk: false
      visible: false

    BotServerDashboardLabel
      id: PreviewHint
      anchors.top: Preview.top
      anchors.left: Preview.left
      anchors.right: Preview.right
      margin-top: 12
      height: 24
      text: Sin posicion reciente para mostrar en el mapa
      text-align: center
      visible: false

  BotServerSkinCard
    id: Alerts
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 34

    UIWidget
      id: Fold
      anchors.left: parent.left
      anchors.top: parent.top
      size: 340 22
      text: Alertas de HP / mana
      text-align: left
      text-offset: 24 0
      font: verdana-11px-antialised
      color: #e4edf3
      focusable: true
      tooltip: Mostrar u ocultar los umbrales de alerta

      BotServerIcon
        id: Arrow
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 18 18
        image-source: botserver_assets/chevron-right.png

    BotServerSkinSwitch
      id: Enabled
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 1
      tooltip: Activar o desactivar avisos locales de HP y mana

    BotServerDashboardLabel
      id: HpLabel
      text: HP:
      anchors.left: parent.left
      anchors.top: Fold.bottom
      margin-top: 4
      width: 28
      height: 20
      visible: false

    SpinBox
      id: Hp
      anchors.left: HpLabel.right
      anchors.top: HpLabel.top
      width: 52
      height: 20
      minimum: 0
      maximum: 100
      step: 5
      visible: false

    BotServerDashboardLabel
      id: ManaLabel
      text: Mana:
      anchors.left: Hp.right
      anchors.top: HpLabel.top
      margin-left: 12
      width: 40
      height: 20
      visible: false

    SpinBox
      id: Mana
      anchors.left: ManaLabel.right
      anchors.top: HpLabel.top
      width: 52
      height: 20
      minimum: 0
      maximum: 100
      step: 5
      visible: false

    CheckBox
      id: Sound
      anchors.left: Mana.right
      anchors.top: HpLabel.top
      margin-left: 16
      width: 96
      height: 20
      font: verdana-11px-antialised
      text: Sonido
      visible: false

    BotServerDashboardLabel
      id: Hint
      text: Umbrales en %. 0 desactiva ese aviso. Solo datos recientes.
      anchors.left: parent.left
      anchors.top: Hp.bottom
      anchors.right: parent.right
      margin-top: 2
      height: 14
      color: #a6b3bf
      visible: false

    BotServerDashboardLabel
      id: Message
      text: Alertas desactivadas
      anchors.left: parent.left
      anchors.top: Hint.bottom
      anchors.right: parent.right
      height: 18
      visible: false

