IconEditorRow < UIWidget
  height: 28
  focusable: true
  background-color: alpha

  $focus:
    background-color: #00000066

  CheckBox
    id: visible
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    size: 15 15
    tooltip: Mostrar u ocultar este icono.

  UIItem
    id: item
    anchors.left: visible.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 24 24
    phantom: true

  Label
    id: name
    anchors.left: item.right
    anchors.right: coords.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    margin-right: 4
    height: 20
    text-align: left
    text-auto-resize: false
    font: verdana-11px-rounded

  Label
    id: coords
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 15
    width: 70
    height: 18
    text-align: right
    color: #a8a8a8

IconEditorColorSwatch < UIWidget
  size: 22 18
  focusable: true
  border-width: 1
  border-color: #777777
  tooltip: Seleccionar este color.

  $hover:
    border-color: #ffffff

  $focus:
    border-width: 2
    border-color: #ffffff

IconEditorModeComboBoxPopupMenu < ComboBoxPopupMenu
IconEditorModeComboBoxPopupMenuButton < ComboBoxPopupMenuButton
IconEditorModeComboBox < ComboBox
  @onSetup: |
    self:addOption("Icono")
    self:addOption("Barra")

IconEditorWindow < MainWindow
  id: IconEditorWindow
  !text: tr('Icon Editor')
  size: 680 538
  @onEscape: self:hide()

  Label
    id: listTitle
    anchors.top: parent.top
    anchors.left: parent.left
    width: 245
    height: 22
    text: Iconos
    color: #9dd1ce
    background-color: #132d2f99
    border-width: 1
    border-color: #365052
    font: verdana-11px-rounded
    text-align: center

  ScrollablePanel
    id: iconList
    anchors.top: listTitle.bottom
    anchors.left: parent.left
    anchors.bottom: bottomSeparator.top
    margin-top: 5
    margin-bottom: 8
    width: 245
    padding: 2
    vertical-scrollbar: iconListScrollBar
    layout: verticalBox
    background: #20202066

  VerticalScrollBar
    id: iconListScrollBar
    anchors.top: iconList.top
    anchors.bottom: iconList.bottom
    anchors.right: iconList.right
    step: 28
    pixels-scroll: true

  VerticalSeparator
    id: middleSeparator
    anchors.top: parent.top
    anchors.bottom: bottomSeparator.top
    anchors.left: iconList.right
    margin-left: 8
    margin-bottom: 8

  Label
    id: selectedTitle
    anchors.top: parent.top
    anchors.left: middleSeparator.right
    anchors.right: parent.right
    margin-left: 9
    height: 22
    text: EDICION INDIVIDUAL
    color: #9dd1ce
    background-color: #132d2f99
    border-width: 1
    border-color: #365052
    font: verdana-11px-rounded
    text-align: center

  Label
    id: nameLabel
    anchors.top: selectedTitle.bottom
    anchors.left: selectedTitle.left
    margin-top: 9
    width: 62
    height: 18
    text: Nombre:

  TextEdit
    id: selectedName
    anchors.left: nameLabel.right
    anchors.right: parent.right
    anchors.verticalCenter: nameLabel.verticalCenter
    margin-left: 5
    height: 20
    font: verdana-11px-rounded
    tooltip: Usa / para dividir el nombre en dos lineas.

  Label
    id: itemLabel
    anchors.top: nameLabel.bottom
    anchors.left: selectedTitle.left
    margin-top: 10
    width: 62
    height: 18
    text: Item:

  BotItem
    id: selectedItem
    anchors.top: itemLabel.top
    anchors.left: itemLabel.right
    margin-left: 5
    size: 36 36
    tooltip: Arrastra aqui el item que quieres mostrar.

  CheckBox
    id: selectedVisible
    anchors.left: selectedItem.right
    anchors.verticalCenter: selectedItem.verticalCenter
    margin-left: 14
    width: 100
    height: 18
    text: Visible

  Label
    id: selectedStyleLabel
    anchors.top: selectedItem.bottom
    anchors.left: selectedTitle.left
    margin-top: 7
    width: 62
    height: 18
    text: Estilo:

  IconEditorModeComboBox
    id: selectedVisualMode
    anchors.left: selectedStyleLabel.right
    anchors.verticalCenter: selectedStyleLabel.verticalCenter
    margin-left: 5
    width: 112
    height: 22
    tooltip: Cambia solamente el icono seleccionado.

  Label
    id: positionLabel
    anchors.top: selectedStyleLabel.bottom
    anchors.left: selectedTitle.left
    margin-top: 9
    width: 62
    height: 18
    text: Posicion:

  Label
    id: xLabel
    anchors.left: positionLabel.right
    anchors.verticalCenter: positionLabel.verticalCenter
    margin-left: 5
    width: 14
    height: 18
    text: X

  SpinBox
    id: selectedX
    anchors.left: xLabel.right
    anchors.verticalCenter: positionLabel.verticalCenter
    margin-left: 3
    width: 72
    minimum: 0
    maximum: 4000
    step: 1
    editable: true
    tooltip: Se aplica inmediatamente al icono seleccionado.

  Label
    id: yLabel
    anchors.left: selectedX.right
    anchors.verticalCenter: positionLabel.verticalCenter
    margin-left: 10
    width: 14
    height: 18
    text: Y

  SpinBox
    id: selectedY
    anchors.left: yLabel.right
    anchors.verticalCenter: positionLabel.verticalCenter
    margin-left: 3
    width: 72
    minimum: 0
    maximum: 4000
    step: 1
    editable: true
    tooltip: Se aplica inmediatamente al icono seleccionado.

  CheckBox
    id: moveSelected
    anchors.left: selectedY.right
    anchors.right: parent.right
    anchors.verticalCenter: positionLabel.verticalCenter
    margin-left: 12
    height: 18
    text: Mover solo este
    tooltip: Permite arrastrar unicamente el icono seleccionado.

  HorizontalSeparator
    id: colorSeparator
    anchors.top: positionLabel.bottom
    anchors.left: selectedTitle.left
    anchors.right: parent.right
    margin-top: 10

  Label
    id: onColorLabel
    anchors.top: colorSeparator.bottom
    anchors.left: selectedTitle.left
    margin-top: 8
    width: 82
    height: 18
    text: Color ON:

  IconEditorColorSwatch
    id: onGreen
    anchors.left: onColorLabel.right
    anchors.verticalCenter: onColorLabel.verticalCenter
    background-color: #00d43a
    tooltip: Verde

  IconEditorColorSwatch
    id: onLime
    anchors.left: onGreen.right
    anchors.verticalCenter: onColorLabel.verticalCenter
    margin-left: 6
    background-color: #77ff55
    tooltip: Lima

  IconEditorColorSwatch
    id: onCyan
    anchors.left: onLime.right
    anchors.verticalCenter: onColorLabel.verticalCenter
    margin-left: 6
    background-color: #32d8ff
    tooltip: Cyan

  IconEditorColorSwatch
    id: onYellow
    anchors.left: onCyan.right
    anchors.verticalCenter: onColorLabel.verticalCenter
    margin-left: 6
    background-color: #ffe45b
    tooltip: Amarillo

  UIWidget
    id: onColorPreview
    anchors.left: onYellow.right
    anchors.right: parent.right
    anchors.verticalCenter: onColorLabel.verticalCenter
    margin-left: 12
    height: 18
    border-width: 1
    border-color: #777777
    background-color: #00d43a
    tooltip: Color seleccionado para el estado encendido.

  Label
    id: offColorLabel
    anchors.top: onColorLabel.bottom
    anchors.left: selectedTitle.left
    margin-top: 8
    width: 82
    height: 18
    text: Color OFF:

  IconEditorColorSwatch
    id: offRed
    anchors.left: offColorLabel.right
    anchors.verticalCenter: offColorLabel.verticalCenter
    background-color: #ff3b3b
    tooltip: Rojo

  IconEditorColorSwatch
    id: offWhite
    anchors.left: offRed.right
    anchors.verticalCenter: offColorLabel.verticalCenter
    margin-left: 6
    background-color: #ffffff
    tooltip: Blanco

  IconEditorColorSwatch
    id: offOrange
    anchors.left: offWhite.right
    anchors.verticalCenter: offColorLabel.verticalCenter
    margin-left: 6
    background-color: #ff9f32
    tooltip: Naranja

  IconEditorColorSwatch
    id: offYellow
    anchors.left: offOrange.right
    anchors.verticalCenter: offColorLabel.verticalCenter
    margin-left: 6
    background-color: #ffe45b
    tooltip: Amarillo

  IconEditorColorSwatch
    id: offCyan
    anchors.left: offYellow.right
    anchors.verticalCenter: offColorLabel.verticalCenter
    margin-left: 6
    background-color: #32d8ff
    tooltip: Cyan

  UIWidget
    id: offColorPreview
    anchors.left: offCyan.right
    anchors.right: parent.right
    anchors.verticalCenter: offColorLabel.verticalCenter
    margin-left: 12
    height: 18
    border-width: 1
    border-color: #777777
    background-color: #ff3b3b
    tooltip: Color seleccionado para el estado apagado.

  Button
    id: applyIcon
    anchors.top: offColorLabel.bottom
    anchors.left: selectedTitle.left
    margin-top: 10
    width: 112
    height: 21
    text: Guardar aspecto
    tooltip: Guardar nombre, item, visibilidad y colores del icono.

  Button
    id: resetIcon
    anchors.left: applyIcon.right
    anchors.verticalCenter: applyIcon.verticalCenter
    margin-left: 7
    width: 104
    height: 21
    text: Restablecer
    tooltip: Volver este icono a su aspecto y posicion original.

  HorizontalSeparator
    id: layoutSeparator
    anchors.top: applyIcon.bottom
    anchors.left: selectedTitle.left
    anchors.right: parent.right
    margin-top: 11

  Label
    id: layoutTitle
    anchors.top: layoutSeparator.bottom
    anchors.left: selectedTitle.left
    anchors.right: parent.right
    margin-top: 6
    height: 22
    text: CONJUNTO DE ICONOS
    color: #9dd1ce
    background-color: #132d2f99
    border-width: 1
    border-color: #365052
    font: verdana-11px-rounded
    text-align: center

  Label
    id: styleLabel
    anchors.top: layoutTitle.bottom
    anchors.left: selectedTitle.left
    margin-top: 9
    width: 48
    height: 18
    text: Estilo:

  IconEditorModeComboBox
    id: visualMode
    anchors.left: styleLabel.right
    anchors.verticalCenter: styleLabel.verticalCenter
    margin-left: 5
    width: 100
    height: 22
    tooltip: Cambia todos los iconos entre item tradicional y barra rectangular.

  Label
    id: opacityLabel
    anchors.left: visualMode.right
    anchors.verticalCenter: styleLabel.verticalCenter
    margin-left: 18
    width: 62
    height: 18
    text: Opac. %:
    text-align: right

  SpinBox
    id: barOpacity
    anchors.left: opacityLabel.right
    anchors.verticalCenter: styleLabel.verticalCenter
    margin-left: 7
    width: 52
    minimum: 10
    maximum: 100
    step: 5
    editable: true
    tooltip: Opacidad del fondo de todas las barras.

  CheckBox
    id: moveGroup
    anchors.top: styleLabel.bottom
    anchors.left: selectedTitle.left
    margin-top: 10
    width: 142
    height: 18
    text: Mover conjunto
    tooltip: Arrastra cualquier icono para desplazar todo el conjunto.

  CheckBox
    id: snapEnabled
    anchors.left: moveGroup.right
    anchors.verticalCenter: moveGroup.verticalCenter
    margin-left: 12
    width: 150
    height: 18
    text: Ajustar a cuadricula
    tooltip: Redondea la posicion al paso indicado al terminar un arrastre.

  Label
    id: gridLabel
    anchors.top: moveGroup.bottom
    anchors.left: selectedTitle.left
    margin-top: 9
    width: 62
    height: 18
    text: Paso px:

  SpinBox
    id: gridSize
    anchors.left: gridLabel.right
    anchors.verticalCenter: gridLabel.verticalCenter
    margin-left: 5
    width: 58
    minimum: 1
    maximum: 32
    step: 1
    editable: true

  Label
    id: columnsLabel
    anchors.left: gridSize.right
    anchors.verticalCenter: gridLabel.verticalCenter
    margin-left: 28
    width: 66
    height: 18
    text: Columnas:

  SpinBox
    id: columns
    anchors.left: columnsLabel.right
    anchors.verticalCenter: gridLabel.verticalCenter
    margin-left: 4
    width: 58
    minimum: 1
    maximum: 8
    step: 1
    editable: true
    tooltip: Redistribuye el conjunto inmediatamente.

  Label
    id: originXLabel
    anchors.top: gridLabel.bottom
    anchors.left: selectedTitle.left
    margin-top: 9
    width: 62
    height: 18
    text: Origen X:

  SpinBox
    id: originX
    anchors.left: originXLabel.right
    anchors.verticalCenter: originXLabel.verticalCenter
    margin-left: 5
    width: 72
    minimum: 0
    maximum: 4000
    step: 1
    editable: true
    tooltip: Mueve inmediatamente el origen horizontal del conjunto.

  Label
    id: originYLabel
    anchors.left: originX.right
    anchors.verticalCenter: originXLabel.verticalCenter
    margin-left: 18
    width: 62
    height: 18
    text: Origen Y:

  SpinBox
    id: originY
    anchors.left: originYLabel.right
    anchors.verticalCenter: originXLabel.verticalCenter
    margin-left: 5
    width: 72
    minimum: 0
    maximum: 4000
    step: 1
    editable: true
    tooltip: Mueve inmediatamente el origen vertical del conjunto.

  Label
    id: gapXLabel
    anchors.top: originXLabel.bottom
    anchors.left: selectedTitle.left
    margin-top: 9
    width: 62
    height: 18
    text: Espacio X:

  SpinBox
    id: gapX
    anchors.left: gapXLabel.right
    anchors.verticalCenter: gapXLabel.verticalCenter
    margin-left: 5
    width: 72
    minimum: 1
    maximum: 300
    step: 1
    editable: true
    tooltip: Separacion horizontal; admite valores desde 1 pixel.

  Label
    id: gapYLabel
    anchors.left: gapX.right
    anchors.verticalCenter: gapXLabel.verticalCenter
    margin-left: 18
    width: 62
    height: 18
    text: Espacio Y:

  SpinBox
    id: gapY
    anchors.left: gapYLabel.right
    anchors.verticalCenter: gapXLabel.verticalCenter
    margin-left: 5
    width: 72
    minimum: 1
    maximum: 300
    step: 1
    editable: true
    tooltip: Separacion vertical; admite valores desde 1 pixel.

  Button
    id: alignGrid
    anchors.top: gapXLabel.bottom
    anchors.left: selectedTitle.left
    margin-top: 10
    width: 138
    height: 21
    text: Aplicar distribucion
    tooltip: Reaplicar origen, columnas y separaciones al conjunto.

  Button
    id: resetAll
    anchors.left: alignGrid.right
    anchors.verticalCenter: alignGrid.verticalCenter
    margin-left: 8
    width: 118
    height: 21
    text: Restablecer todo

  Label
    id: iconStatus
    anchors.left: resetAll.right
    anchors.right: parent.right
    anchors.verticalCenter: alignGrid.verticalCenter
    margin-left: 9
    height: 21
    text-align: center
    color: #b8c7cc
    text: Selecciona un icono

  HorizontalSeparator
    id: bottomSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 60
    height: 21
    text: Cerrar
    @onClick: self:getParent():hide()
