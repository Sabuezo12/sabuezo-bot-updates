TimerExecutorActionTypeBoxPopupMenu < ComboBoxPopupMenu
TimerExecutorActionTypeBoxPopupMenuButton < ComboBoxPopupMenuButton
TimerExecutorActionTypeBox < ComboBox
  height: 20
  font: verdana-11px-rounded
  @onSetup: |
    self:addOption("Say")
    self:addOption("Cast")
    self:addOption("Use Item")
    self:addOption("Use Self")
    self:addOption("Use Target")
    self:addOption("Use Tile")
    self:addOption("Lua")

TimerExecutorActionRow < Panel
  height: 92
  margin-top: 3
  background-color: #00000022

  CheckBox
    id: enabled
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 3
    margin-top: 3
    width: 18
    height: 18
    tooltip: Enable this action

  TimerExecutorActionTypeBox
    id: actionType
    anchors.left: enabled.right
    anchors.top: enabled.top
    margin-left: 4
    width: 104

  SpinBox
    id: interval
    anchors.left: actionType.right
    anchors.top: actionType.top
    margin-left: 4
    width: 68
    height: 20
    minimum: 1
    maximum: 86400
    step: 1
    editable: true
    focusable: true
    tooltip: Seconds between executions

  Label
    id: secondsLabel
    anchors.left: interval.right
    anchors.verticalCenter: interval.verticalCenter
    margin-left: 3
    width: 16
    font: verdana-11px-rounded
    text: s

  Button
    id: remove
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 3
    margin-right: 3
    width: 22
    height: 20
    text: X
    tooltip: Remove action

  Button
    id: run
    anchors.right: remove.left
    anchors.top: remove.top
    margin-right: 4
    width: 38
    height: 20
    text: Run
    tooltip: Execute now

  BotItem
    id: item
    anchors.left: parent.left
    anchors.top: enabled.bottom
    margin-left: 4
    margin-top: 5

  TextEdit
    id: value
    anchors.left: item.right
    anchors.right: parent.right
    anchors.top: item.top
    margin-left: 8
    margin-right: 5
    height: 20
    font: verdana-11px-rounded
    tooltip: Text, spell words, x,y tile offset, or Lua code

  CheckBox
    id: skipPz
    anchors.left: value.left
    anchors.top: value.bottom
    margin-top: 5
    width: 44
    height: 18
    text: PZ
    tooltip: Skip while in protection zone

  CheckBox
    id: skipAttack
    anchors.left: skipPz.right
    anchors.top: skipPz.top
    margin-left: 8
    width: 52
    height: 18
    text: ATK
    tooltip: Skip while attacking

  CheckBox
    id: runOnStart
    anchors.left: skipAttack.right
    anchors.top: skipPz.top
    margin-left: 8
    width: 58
    height: 18
    text: Start
    tooltip: Run when the module is enabled

  CheckBox
    id: once
    anchors.left: runOnStart.right
    anchors.top: skipPz.top
    margin-left: 8
    width: 54
    height: 18
    text: Once
    tooltip: Disable this action after it runs

  Label
    id: status
    anchors.right: parent.right
    anchors.verticalCenter: once.verticalCenter
    margin-right: 6
    width: 110
    text-align: right
    font: verdana-11px-rounded
    color: #aaaaaa
    text: -

TimerExecutorWindow < MainWindow
  !text: tr('Timer Executor')
  size: 540 420
  @onEscape: self:hide()

  Label
    id: title
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-align: center
    font: verdana-11px-rounded
    color: #9dd1ce
    text: Timed Actions

  ScrollablePanel
    id: list
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: title.bottom
    anchors.bottom: bottomSep.top
    margin-top: 7
    margin-bottom: 8
    padding: 2
    vertical-scrollbar: listScrollBar
    layout: verticalBox

  VerticalScrollBar
    id: listScrollBar
    anchors.top: list.top
    anchors.bottom: list.bottom
    anchors.right: list.right
    step: 20
    pixels-scroll: true

  HorizontalSeparator
    id: bottomSep
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: add.top
    margin-bottom: 8

  Button
    id: add
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 70
    height: 21
    text: New
    tooltip: Add action

  Button
    id: reset
    anchors.left: add.right
    anchors.bottom: parent.bottom
    margin-left: 6
    width: 70
    height: 21
    text: Reset
    tooltip: Restart timers

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 55
    height: 21
    text: Close
    @onClick: self:getParent():hide()
