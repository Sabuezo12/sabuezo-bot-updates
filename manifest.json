/Sabuezo12/sabuezo-bot-updates/main/vBot/extrasPvp.lua","size":15199,"sha256":"8ffe1ebf48a7fe94f9dd3a9d8140b18a1d0986206097f89c83334b6410d86107"}],"history":[{"version":"1.0.1","date":"2026-05-21","title":"Updater base","changes":["Sistema de actualizaciones desde GitHub.","Manifest con archivos, tamanos y hash sha256."],"files":["vBot/Updater.lua","manifest.json"]},{"version":"1.0.2","date":"2026-05-21","title":"Visual Main","changes":["Nuevo banner visual By: Sabuezo made for Slegna Guild.","Iconos actualizados: Cave 12548, Target 7438, Ering 3088."],"files":["vBot/main.lua","vBot/iconos.lua"]},{"version":"1.0.3","date":"2026-05-21","title":"Check Players","changes":["Check Players detecta vocaciones y muestra MS, RP, ED o EK.","Reconoce variantes como hell wizard, force archer, high saintes y titan blader.","El look a players se hace de forma mas controlada para evitar spam."],"files":["vBot/extras.lua"]},{"version":"1.0.4","date":"2026-05-21","title":"Updater con ventana","changes":["Nueva ventana OTUI para ver notas, version instalada, version disponible y archivos pendientes.","El panel Main muestra estado visual y hace check automatico al recargar el bot.","El updater puede descargar solo archivos pendientes usando history y sha256.","Tooltips del updater en espanol."],"files":["vBot/Updater.lua","vBot/Updater.otui"]},{"version":"1.0.5","date":"2026-05-21","title":"Carga robusta del updater OTUI","changes":["Updater.lua ahora importa vBot/Updater.otui por su cuenta antes de crear la ventana.","Si el OTUI se descarga despues de cargar el bot, el boton Check intenta crear la ventana de nuevo.","Muestra aviso claro si Updater.otui no se pudo cargar."],"files":["vBot/Updater.lua"]},{"version":"1.0.6","date":"2026-05-21","title":"Vista limpia del updater","changes":["El panel Main del updater muestra solo version instalada, version disponible y estado.","Las notas de update se mantienen solo dentro de la ventana OTUI.","La ventana OTUI se reorganizo para evitar texto encimado o mal cortado."],"files":["vBot/Updater.lua","vBot/Updater.otui"]},{"version":"1.0.61","date":"2026-05-21","title":"Player List: guild sin apodos","changes":["Corrige la deteccion de guild al hacer look.","Slegna (LaMaquina) ahora se toma como Slegna.","Tambien corrige la guild guardada si ya tenia apodo."],"files":["vBot/playerlist.lua"]},{"version":"1.0.62","date":"2026-05-21","title":"Updater: panel limpio","changes":["El panel Main del updater ya no muestra notas del parche.","Solo muestra version instalada, version disponible y estado.","Las notas quedan dentro de la ventana del updater."],"files":["vBot/Updater.lua","vBot/Updater.otui"]},{"version":"1.0.63","date":"2026-05-21","title":"Player List: vocaciones custom","changes":["Reconoce Force Archer, Hell Wizard, High Saintes y Titan Blader.","Tambien reconoce variantes con Supreme.","Los miembros de guild se agregan aunque la vocacion aun no este detectada."],"files":["vBot/playerlist.lua"]},{"version":"1.0.64","date":"2026-05-21","title":"AttackBot: encendido manual","changes":["AttackBot puede quedar encendido aunque TargetBot este apagado.","Si se prende manualmente con TargetBot apagado, el sync no lo apaga.","Al apagar AttackBot manualmente, vuelve al comportamiento normal."],"files":["vBot/AttackBot.lua"]},{"version":"1.0.65","date":"2026-05-21","title":"Player List: parser de vocaciones","changes":["Detecta vocaciones aunque el look no use a/an.","Ejemplo: He is Hell Wizard ahora se lee como MS.","Limpia prefijos a, an y Supreme antes de comparar vocacion."],"files":["vBot/playerlist.lua"]},{"version":"1.0.66","title":"Player List: articulo the","changes":["Corrige vocaciones con articulo the.","Ejemplo: He is the Titan Blader ahora se detecta como EK.","El texto Age: (...) se ignora; solo se usa la frase He/She is."],"files":["vBot/playerlist.lua"]},{"version":"1.0.67","title":"CaveBot: seguridad solo activa con CaveBot","changes":["Seguridad por muertes ya no cuenta ni ejecuta acciones si CaveBot esta apagado.","Anti Red del CaveBot solo actua cuando CaveBot esta encendido.","La espera por muertes se mantiene como estado interno para poder terminar y reanudar la hunt."],"files":["cavebot/config.lua"]},{"version":"1.0.68","date":"2026-05-22","title":"Contadores y BotServer","changes":["CaveBot Stats usa el contador de supplies con server log y muestra muertes.","Supply Check usa el contador aprendido para validar supplies aunque no esten visibles.","El contador aprende nombres de supplies por ID y empata mejor los mensajes del server log.","BotServer registra listeners al conectar o reconectar y sincroniza vocacion automaticamente."],"files":["vBot/vlib.lua","vBot/analyzer.lua","vBot/analyzer.otui","vBot/supplies.lua","vBot/BotServer.lua","vBot/BotServer.otui"]},{"version":"1.0.69","date":"2026-05-22","title":"BotServer: contador conectado","changes":["BotServer ahora usa presencia entre chars para contar conectados.","El panel ya no depende solo de la respuesta list del servidor.","El tooltip de Members muestra los chars detectados por presencia reciente."],"files":["vBot/BotServer.lua"]},{"version":"1.0.70","date":"2026-05-22","title":"BotServer: fallback local","changes":["Agrega bus local por archivos para comunicar chars aunque el websocket nativo no retransmita.","El contador de conectados lee presencia local compartida por canal.","Broadcast, vocacion, mana y mwalls tienen respaldo local entre chars del mismo cliente.","El estado puede mostrar LOCAL BUS cuando no hay websocket nativo pero el canal local sigue funcionando."],"files":["vBot/BotServer.lua"]},{"version":"1.0.71","date":"2026-05-22","title":"BotServer: canal Slegna","changes":["BotServer usa Slegna14325 como canal por defecto.","Al actualizar, BotServer se activa automaticamente una sola vez.","Despues del primer arranque, si el usuario lo apaga o cambia el canal, se respeta su ajuste."],"files":["vBot/BotServer.lua"]},{"version":"1.0.72","date":"2026-05-22","title":"Optimizacion de iconos y contador","changes":["ItemCounter deja de registrar el mismo item/alias en cada ciclo.","Se agrega limpieza ligera de memoria Lua para reducir crecimiento lento.","AutoBuff ya no crea icono propio; queda controlado por el panel central de iconos.","Se eliminan controles viejos de iconos en CaveBot \u0026 Target Settings y Extras PvP."],"files":["vBot/vlib.lua","vBot/ItemCounter.lua","zFreeScripts/zAutoBuff.lua","vBot/cave_target_settings.lua","vBot/extrasPvp.lua"]},{"version":"1.0.73","date":"2026-05-23","title":"Loader organizado por pestanas","changes":["El loader queda separado por secciones Main, Tools, Cave, Target y HP.","Se conserva el orden visual de los scripts dentro de cada pestana.","Los scripts base quedan en Core y los scripts finales quedan en Final para no romper dependencias."],"files":["_Loader.lua"]}]}