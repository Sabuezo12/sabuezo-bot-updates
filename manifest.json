buezo-bot-updates/refs/heads/main/zFreeScripts/CaveBotHUD.lua","size":7393,"sha256":"93537296e180c7eddfcee7198e970b59bd8177cb6a24038bf234cdaee29be6f5"},{"path":"zFreeScripts/z_Auto-Party.lua","url":"https://raw.githubusercontent.com/Sabuezo12/sabuezo-bot-updates/refs/heads/main/zFreeScripts/z_Auto-Party.lua","size":18054,"sha256":"5c48cab13c31eb717b279b46dc6d0f7c7e8d1b079dc8c27e7714510cdd100cff"},{"path":"zFreeScripts/zAutoBuff.lua","url":"https://raw.githubusercontent.com/Sabuezo12/sabuezo-bot-updates/refs/heads/main/zFreeScripts/zAutoBuff.lua","size":10361,"sha256":"b95840f0e66c53979de6000061623d5104f71fee427b752095d65fdafef7d3d8"},{"path":"targetbot/creature_attack.lua","url":"https://raw.githubusercontent.com/Sabuezo12/sabuezo-bot-updates/refs/heads/main/targetbot/creature_attack.lua","size":14114,"sha256":"1fd67de49cfc4ff7866934cbe4dd5427618f018198a2dcca132f148e58d01b3f"}],"history":[{"version":"1.0.107","date":"2026-06-22","title":"Buff Guild y AttackBot","changes":["Buff Guild permite que exura boost y exura haste trabajen en ciclos independientes.","Exura haste ya no prioriza vocaciones: aplica a todos los aliados por igual.","El reintento por exhaust del Buff Guild baja a 200 ms.","AttackBot mejora el posicionamiento para spells direccionales y deja cooldown nuevo en 2000 ms.","Se agrega la dependencia de alineacion del TargetBot para beams, waves y spells frontales.","CaveBot optimiza el action goto intentando caminar antes de calculos pesados.","CaveBotHUD lee stats desde SabuezoAnalyzer."],"files":["vBot/Buffguild.lua","vBot/AttackBot.lua","vBot/AttackBot.otui","targetbot/creature_attack.lua","cavebot/actions.lua","zFreeScripts/CaveBotHUD.lua"]},{"version":"1.0.106","date":"2026-06-15","title":"Pushmax retarget inmediato","changes":["Pushmax conserva el DEST cuando cambias de target.","Al cambiar de target limpia cooldowns, colas de push 1 sqm, runup y anti-stuck del target anterior.","El nuevo target se reengancha inmediatamente para evitar la espera antes de pushear."],"files":["vBot/pushmax.lua"]},{"version":"1.0.105","date":"2026-06-14","title":"Container Manager mejorado","changes":["Container Manager abre automaticamente las BPs configuradas cuando las detecta dentro de cualquier BP abierta.","Sort Items ahora puede mover items desde cualquier BP abierta hacia la BP configurada correcta.","La backpack equipada se renombra como Main Bp.","La ventana ahora muestra Container Manager - By Sabuezo."],"files":["vBot/ContainerManager.lua"]},{"version":"1.0.104","date":"2026-06-14","title":"Hotfix CaveBot delay","changes":["Hotfix: CaveBot vuelve a ejecutar sus actions dentro de macro() para que delay() funcione correctamente.","Corrige el error visual: Invalid usage of delay function."],"files":["cavebot/cavebot.lua"]},{"version":"1.0.103","date":"2026-06-14","title":"Target loot global","changes":["TargetBot mueve Ignore Creatures al panel Target arriba de Items to loot.","Items to loot y Containers for loot quedan compartidos entre perfiles del TargetBot.","La lista principal de monstruos del TargetBot muestra mas entradas visibles."],"files":["vBot/cave_target_settings.lua","targetbot/looting.lua","targetbot/looting.otui","targetbot/target.otui"]}]}