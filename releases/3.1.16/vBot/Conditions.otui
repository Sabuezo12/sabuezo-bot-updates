  HelperThemeCheck
    height: 18
    margin-top: 64
    margin-left: 146
    anchors.top: parent.top
    anchors.left: parent.left
    id: HoldUtamo
    width: 100
    text: Mantener

  ConditionName
    height: 18
    width: 78
    margin-top: 84
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: utanaLabel
    text: Utana Vid

  ConditionSpinBox
    height: 18
    width: 50
    margin-top: 84
    margin-left: 86
    anchors.top: parent.top
    anchors.left: parent.left
    id: UtanaCost

  HelperThemeCheck
    height: 18
    margin-top: 84
    margin-left: 146
    anchors.top: parent.top
    anchors.left: parent.left
    id: HoldUtana
    width: 100
    text: Mantener

  ConditionName
    height: 18
    width: 78
    margin-top: 104
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: recoveryLabel
    text: Recovery

  ConditionSpinBox
    height: 18
    width: 50
    margin-top: 104
    margin-left: 86
    anchors.top: parent.top
    anchors.left: parent.left
    id: UturaCost

  HelperThemeCheck
    height: 18
    margin-top: 104
    margin-left: 146
    anchors.top: parent.top
    anchors.left: parent.left
    id: HoldUtura
    width: 100
    text: Mantener

  HelperThemeLabel
    margin-top: 124
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: recoverySpellLabel
    width: 40
    height: 18
    text: Spell:
    font: verdana-11px-antialised

  UturaComboBox
    margin-top: 124
    margin-left: 48
    anchors.top: parent.top
    anchors.left: parent.left
    id: UturaType
    width: 198
    height: 18
    font: verdana-11px-antialised

  HelperThemeCheck
    margin-top: 148
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: IgnoreInPz
    width: 246
    height: 14
    text: No lanzar en PZ
    tooltip: Pausa curas, buffs y Recovery en PZ. Anti-Paralyze queda independiente.
    font: verdana-11px-antialised

  HelperThemeCheck
    margin-top: 166
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: PauseWhileAttacking
    width: 246
    height: 14
    text: Pausar en combate (PvE/PvP)
    tooltip: Haste pausa con un ataque activo. Las otras curas y buffs pausan con estado de combate, un objetivo activo o monstruos a 7 casillas. Exana Pox, Utura y Utura Gran siempre esperan a salir de combate. Anti-Paralyze queda independiente.
    font: verdana-11px-antialised

ConditionsWindow < HelperThemeWindow
  padding-bottom: 8
  padding-top: 8
  padding: 8
  id: ConditionsWindow
  !text: tr('Conditions')
  size: 500 306
  @onEscape: self:hide()

  AntiParalyseConditions
    height: 68
    width: 484
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    id: Anti

  CureConditions
    height: 184
    width: 224
    margin-top: 74
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    id: Cure

  HoldConditions
    height: 184
    width: 254
    margin-top: 74
    margin-left: 230
    anchors.top: parent.top
    anchors.left: parent.left
    id: Hold

  HelperThemeDivider
    height: 1
    width: 484
    margin-top: 264
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    id: separator

  HelperThemeButton
    height: 18
    width: 58
    margin-top: 272
    margin-left: 426
    anchors.top: parent.top
    anchors.left: parent.left
    id: closeButton
    !text: tr('Close')
