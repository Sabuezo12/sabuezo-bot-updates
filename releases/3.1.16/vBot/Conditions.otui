HoldConditions < HelperThemeSection
  id: Hold
  width: 254
  height: 184

  ConditionSectionTitle
    height: 16
    width: 246
    margin-top: 4
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: title
    text: MANTENER BUFFS

  ConditionName
    height: 18
    width: 78
    margin-top: 24
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: hasteLabel
    text: Haste

  ConditionSpinBox
    height: 18
    width: 50
    margin-top: 24
    margin-left: 86
    anchors.top: parent.top
    anchors.left: parent.left
    id: HasteCost

  HelperThemeCheck
    height: 18
    margin-top: 24
    margin-left: 146
    anchors.top: parent.top
    anchors.left: parent.left
    id: HoldHaste
    width: 100
    text: Mantener
    tooltip: Renueva Haste al caminar. Respeta mana, cooldown, la opcion de PZ y la pausa mientras tienes un ataque activo.

  HelperThemeLabel
    margin-top: 44
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: hasteSpellLabel
    width: 40
    height: 18
    text: Spell:
    font: verdana-11px-antialised

  HelperThemeInput
    margin-top: 44
    margin-left: 48
    anchors.top: parent.top
    anchors.left: parent.left
    id: HasteSpell
    width: 198
    height: 18
    font: verdana-11px-antialised
    padding: 1
    padding-left: 4
    padding-right: 4
    text-align: left

  ConditionName
    height: 18
    width: 78
    margin-top: 64
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
