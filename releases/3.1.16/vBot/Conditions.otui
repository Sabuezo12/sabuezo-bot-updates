UturaComboBoxPopupMenu < HelperThemeComboPopupMenu
UturaComboBoxPopupMenuButton < HelperThemeComboPopupMenuButton
UturaComboBox < HelperThemeCombo
  @onSetup: |
    self:addOption("Utura")
    self:addOption("Utura Gran")

ConditionSpinBox < HelperThemeSpin
  size: 50 18
  minimum: 0
  maximum: 9999
  step: 1
  editable: true
  text-align: center
  font: verdana-11px-antialised

ConditionSectionTitle < HelperThemeSectionTitle
  height: 16
  background-color: #244b53
  color: #d8ffff
  font: verdana-11px-antialised
  text-align: center

ConditionName < HelperThemeLabel
  width: 80
  height: 18
  color: #ffaa00
  font: verdana-11px-antialised
  text-align: left

AntiParalyseConditions < HelperThemeSection
  id: Anti
  height: 68

  ConditionSectionTitle
    height: 16
    width: 476
    margin-top: 4
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: title
    text: ANTI-PARALYZE

  HelperThemeCheck
    margin-top: 24
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: CureParalyse
    width: 72
    height: 18
    text: Activar
    tooltip: Quita la paralisis con prioridad, incluso en PZ o atacando monstruos.

  HelperThemeLabel
    height: 18
    margin-top: 24
    margin-left: 80
    anchors.top: parent.top
    anchors.left: parent.left
    id: spellLabel
    width: 34
    text: Spell:
    font: verdana-11px-antialised

  HelperThemeInput
    margin-top: 24
    margin-left: 116
    anchors.top: parent.top
    anchors.left: parent.left
    id: ParalyseSpell
    width: 214
    height: 18
    font: verdana-11px-antialised
    tooltip: Hechizo principal para quitar la paralisis.
    padding: 1
    padding-left: 4
    padding-right: 4
    text-align: left

  HelperThemeLabel
    height: 18
    margin-top: 24
    margin-left: 336
    anchors.top: parent.top
    anchors.left: parent.left
    id: manaLabel
    width: 38
    text: Mana:
    font: verdana-11px-antialised

  ConditionSpinBox
    height: 18
    width: 50
    margin-top: 24
    margin-left: 378
    anchors.top: parent.top
    anchors.left: parent.left
    id: ParalyseCost

  HelperThemeCheck
    margin-top: 46
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    id: UseHasteFallback
    width: 238
    height: 18
    text: Usar Haste como respaldo
    tooltip: Si el principal no esta disponible o sigues paralizado, intenta el Haste configurado respetando sus cooldowns.

  HelperThemeLabel
    margin-top: 46
    margin-left: 246
    anchors.top: parent.top
    anchors.left: parent.left
    id: AntiStatus
    width: 234
    height: 18
    text: Anti: esperando
    text-align: right
    color: #7de58a
    font: verdana-11px-antialised

