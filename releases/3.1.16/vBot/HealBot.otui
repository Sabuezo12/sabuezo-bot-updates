// Compact controls need their own padding: 18px minus the theme's 8px
// vertical padding leaves less room than the font and clips typed text.
HealTextInput < HelperThemeInput
  height: 22
  padding: 0
  padding-left: 5
  padding-right: 5
  text-offset: 0 0
  text-align: left

HealComboPopupMenu < HelperThemeComboPopupMenu
HealComboPopupMenuButton < HelperThemeComboPopupMenuButton
HealCombo < HelperThemeCombo
  height: 22
  padding: 0
  padding-left: 5
  padding-right: 18
  text-offset: 0 0
  text-align: left

HealSettingCheckBox < HelperThemeCheck
  height: 20
  text-wrap: true
  text-auto-resize: false
  margin-top: 0
  font: verdana-11px-antialised

SpellSourceBoxPopupMenu < HelperThemeComboPopupMenu
SpellSourceBoxPopupMenuButton < HelperThemeComboPopupMenuButton
SpellSourceBox < HealCombo
  @onSetup: |
    self:addOption("Mana (%)")
    self:addOption("Vida (%)")
    self:addOption("Dano reciente")

SpellConditionBoxPopupMenu < HelperThemeComboPopupMenu
SpellConditionBoxPopupMenuButton < HelperThemeComboPopupMenuButton
SpellConditionBox < HealCombo
  @onSetup: |
    self:addOption("Menor que")
    self:addOption("Mayor que")
    self:addOption("Igual a")

HealRelationBoxPopupMenu < HelperThemeComboPopupMenu
HealRelationBoxPopupMenuButton < HelperThemeComboPopupMenuButton
HealRelationBox < HealCombo
  @onSetup: |
    self:addOption("y")
    self:addOption("o")

SpellEntry < HelperThemeLabel
  background-color: #00000000
  padding: 0
  text-align: left
  text-offset: 24 0
  focusable: true
  height: 22
  $focus:
    background-color: #18434a
  HelperThemeCheck
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 14 14
    margin-left: 4
  HelperThemeButton
    id: remove
    text: X
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    size: 16 16

ItemEntry < HelperThemeLabel
  background-color: #00000000
  padding: 0
  text-align: left
  text-offset: 44 0
  focusable: true
  height: 22
  $focus:
    background-color: #18434a
  HelperThemeCheck
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 14 14
    margin-left: 4
  UIItem
    id: id
    anchors.left: enabled.right
    margin-left: 4
    anchors.verticalCenter: parent.verticalCenter
    size: 18 18
    focusable: false
  HelperThemeButton
    id: remove
    text: X
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    size: 16 16

