HealBotHealerPanelV3 < Panel
  HealBotSpellHealingV3
    id: spells
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
  HealBotItemHealingV3
    id: items
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    visible: false

HealBotSettingsPanelV3 < Panel
  HelperThemeCard
    id: list
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    anchors.right: parent.horizontalCenter
    margin-right: 6
    padding: 8
    layout:
      type: verticalBox
      spacing: 3
    HelperThemeLabel
      text: Condiciones de curacion
      color: #50d7d4
      height: 20
    HealSettingCheckBox
      id: Cooldown
      text: Revisar espera de hechizos
    HealSettingCheckBox
      id: ClientCooldowns
      text: Priorizar cooldowns del cliente
    HealSettingCheckBox
      id: Visible
      text: Los items deben estar visibles
    HealSettingCheckBox
      id: Delay
      text: Evitar items al interactuar
    HealSettingCheckBox
      id: Interval
      text: Espera extra al recoger loot
    HealSettingCheckBox
      id: Conditions
      text: Revisar condiciones de RL Tibia
    HealSettingCheckBox
      id: MessageDelay
      text: Espera por mensaje Aaaah...
    HealSettingCheckBox
      id: OldSchool
      text: Modo clasico sin hotkeys
  HelperThemeCard
    id: profiles
    anchors.top: parent.top
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 6
    padding: 8
    HelperThemeLabel
      id: heading
      text: Perfil actual
      color: #50d7d4
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 20
    HelperThemeLabel
      id: nameLabel
      text: Nombre del perfil
      anchors.top: heading.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 18
    HealTextInput
      height: 22
      id: Name
      anchors.top: nameLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
    HelperThemeLabel
      anchors.top: Name.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 14
      height: 70
      text-wrap: true
      color: #a9bbc6
      text: Cada perfil conserva sus reglas, condiciones y estado. Cambiar de perfil carga sus valores guardados.
    HelperThemeButton
      height: 20
      id: ResetSettings
      text: Restablecer este perfil
      color: #ffb4a7
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right

HealWindowV3 < HelperThemeWindow
  padding-bottom: 8
  text: HealBot
  size: 552 348
  @onEscape: self:hide()
  HelperThemeSection
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 46
    width: 536
    id: profileGroup
    phantom: true
    focusable: false
  HelperThemeButton
    margin-top: 3
    margin-left: 488
    anchors.top: parent.top
    anchors.left: parent.left
    width: 44
    id: power
    height: 18
    padding: 0
    text: OFF
  HealCombo
    margin-top: 2
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    height: 22
    width: 102
    id: profileSelect
  HelperThemeLabel
    margin-top: 2
    margin-left: 116
    anchors.top: parent.top
    anchors.left: parent.left
    width: 364
    id: profileName
    height: 20
    text: Perfil
  Panel
    margin-top: 26
    margin-left: 4
    anchors.top: parent.top
    anchors.left: parent.left
    width: 528
    id: tabs
    height: 20
    layout:
      type: horizontalBox
      spacing: 4
    HelperThemeButton
      id: spells
      text: Hechizos
      size: 86 20
    HelperThemeButton
      id: items
      text: Objetos
      size: 76 20
    HelperThemeButton
      id: conditions
      text: Condiciones y perfil
      size: 150 20
  HelperThemeLabel
    margin-top: 50
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    font: verdana-11px-antialised
    width: 536
    id: title
    text: Doble clic edita una regla; Subir y Bajar cambian su prioridad.
    color: #a9bbc6
    height: 18
  HealBotHealerPanelV3
    margin-top: 70
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 224
    width: 536
    id: healer
  HealBotSettingsPanelV3
    margin-top: 70
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 224
    width: 536
    id: settings
    visible: false
  HelperThemeDivider
    margin-top: 300
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 1
    width: 536
    id: separator
  HelperThemeButton
    margin-top: 308
    margin-left: 420
    anchors.top: parent.top
    anchors.left: parent.left
    height: 22
    width: 116
    id: closeButton
    text: Guardar y volver
  HelperThemeButton
    margin-top: 308
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 22
    width: 100
    id: settingsButton
    text: Condiciones
    visible: false
