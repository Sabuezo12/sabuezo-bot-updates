StudioLabel < HelperThemeLabel
  font: verdana-11px-antialised
  text-align: left
  color: #e1e4e3
  phantom: true

StudioButton < HelperThemeButton
  font: verdana-11px-antialised
  height: 20
  $on:
    image-color: #dfdfdf
    color: #dcfffa

StudioAccentButton < StudioButton

StudioToggle < HelperThemeSwitch

StudioTab < StudioButton
  padding: 0
  UIWidget
    id: indicator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 8
    margin-bottom: 2
    height: 2
    background-color: #59c8bf
    phantom: true
    visible: false

StudioCheck < HelperThemeCheck
  font: verdana-11px-antialised
  height: 18
  color: #e1e4e3

StudioBox < HelperThemeCard
  padding: 0

StudioSpellBox < StudioBox
  image-color: #a6a6a6

StudioEdit < HelperThemeInput
  font: verdana-11px-antialised
  color: #dce5e2
  selection-color: #ffffff
  selection-background-color: #477b72
  image-source:
  image-border: 1

StudioNumber < Panel
  height: 20
  StudioButton
    id: minus
    anchors.left: parent.left
    anchors.top: parent.top
    width: 15
    height: 20
    padding: 0
    text: -
  StudioEdit
    id: input
    anchors.left: minus.right
    anchors.right: plus.left
    anchors.top: parent.top
    height: 20
    margin-left: 2
    margin-right: 2
    text-align: center
  StudioButton
    id: plus
    anchors.right: parent.right
    anchors.top: parent.top
    width: 15
    height: 20
    padding: 0
    text: +

StudioEntry < UIWidget
  height: 30
  focusable: true
  background-color: #17171788
  $hover:
    background-color: #393939bb
  $on:
    background-color: #3c3c3ccc
    border-width: 1
    border-color: #59bdb2
  StudioCheck
    id: enabled
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 5
    margin-top: 7
    width: 15
    height: 15
  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 25
    margin-top: 4
    width: 22
    height: 22
    phantom: true
  UIItem
    id: item
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 24
    margin-top: 3
    width: 24
    height: 24
    virtual: true
    phantom: true
    visible: false
  StudioLabel
    id: title
    anchors.left: parent.left
    anchors.right: minimum.left
    anchors.top: parent.top
    margin-left: 53
    margin-right: 4
    margin-top: 1
    height: 15
    font: verdana-11px-antialised
  StudioLabel
    id: words
    margin-top: 1
    anchors.left: title.left
    anchors.right: title.right
    anchors.top: title.bottom
    height: 12
    color: #a4b3af
    font: verdana-9px
  StudioLabel
    id: minimum
    anchors.right: cooldown.left
    anchors.verticalCenter: parent.verticalCenter
    width: 28
    height: 16
    text-align: center
  StudioLabel
    id: cooldown
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 5
    width: 30
    height: 16
    text-align: center

AttackStudioWindow < HelperThemeWindow
  text: AttackBot | Rotacion de caza
  font: verdana-11px-antialised
  size: 552 560
  padding-top: 10
  padding-bottom: 8
  StudioLabel
    id: vocationLabel
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 0
    margin-top: 0
    width: 52
    height: 22
    text: Vocacion
  HelperThemeCombo
    tooltip: Edita la rotacion de esta vocacion. Cada vocacion conserva su lista dentro del perfil.
    id: vocation
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 54
    margin-top: 0
    width: 100
    height: 22
  StudioLabel
    id: modeLabel
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 164
    margin-top: 0
    width: 34
    height: 22
    text: Modo
  HelperThemeCombo
    tooltip: PvE o PvP del perfil. Los cambios se guardan al pulsar Aplicar cambios.
    id: mode
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 200
    margin-top: 0
    width: 58
    height: 22
  StudioLabel
    id: profileLabel
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 270
    margin-top: 0
    width: 34
    height: 22
    text: Perfil
  HelperThemeCombo
    tooltip: Elige uno de los cinco perfiles. Si hay cambios, puedes aplicarlos o descartarlos antes de cambiar.
    id: profile
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 306
    margin-top: 0
    width: 174
    height: 22
  StudioToggle
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: profile.verticalCenter
    margin-left: 486
    width: 44
    height: 18
    padding: 0
    text: OFF
  StudioTab
    tooltip: Lista, condiciones y detalles de cada spell. Selecciona una fila para editarlo aqui mismo.
    id: rotationTab
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 0
    margin-top: 28
    width: 94
    height: 22
    text: Rotacion
  StudioTab
    tooltip: Protecciones frente a jugadores, listas Anti-RS, kills y trainers.
    id: safetyTab
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 102
    margin-top: 28
    width: 94
    height: 22
    text: Seguridad
  StudioTab
    tooltip: Nombre del perfil, cooldowns, requisitos, giro y restauracion de la rotacion.
    id: advancedTab
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 204
    margin-top: 28
    width: 94
    height: 22
    text: Avanzado
