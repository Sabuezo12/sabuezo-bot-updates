TargetStudioText < HelperThemeLabel
  font: verdana-11px-antialised
  text-align: left
  phantom: true

TargetStudioAmount < Panel
  height: 22
  width: 192
  margin-top: 2
  TargetStudioText
    id: caption
    anchors.left: parent.left
    anchors.right: controls.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    height: 18
  Panel
    id: controls
    anchors.right: parent.right
    anchors.top: parent.top
    width: 78
    height: 22
    HelperThemeButton
      id: minus
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 0
      margin-top: 0
      width: 18
      height: 22
      text: -
    HelperThemeButton
      id: plus
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 60
      margin-top: 0
      width: 18
      height: 22
      text: +
    HelperThemeInput
      id: input
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 19
      margin-top: 0
      width: 40
      height: 22
      text-align: center

TargetStudioOption < UIWidget
  height: 20
  margin-top: 2
  focusable: true
