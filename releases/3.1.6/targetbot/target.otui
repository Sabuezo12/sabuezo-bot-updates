TargetBotEntry < HelperThemeLabel
  background-color: alpha
  text-offset: 2 0
  focusable: true

  $focus:
    background-color: #00000055

TargetBotDualLabel < Panel
  height: 18
  margin-left: 3
  margin-right: 4

  HelperThemeLabel
    id: left
    anchors.top: parent.top
    anchors.left: parent.left
    width: 56
    height: 18
    text-auto-resize: false

  HelperThemeLabel
    id: right
    anchors.top: parent.top
    anchors.left: left.right
    anchors.right: parent.right
    margin-left: 6
    height: 18
    text-align: left
    text-auto-resize: false
    text-wrap: false


TargetStudioProfile < Panel
  height: 28
  HelperThemeCombo
    id: list
    anchors.left: parent.left
    anchors.right: add.left
    anchors.top: parent.top
    margin-left: 0
    margin-top: 0
    margin-right: 6
    height: 24
  HelperThemeButton
    id: add
    anchors.right: remove.left
    anchors.top: parent.top
    margin-right: 6
    margin-top: 0
    width: 54
    height: 24
    text: Nueva
    tooltip: Crear un perfil de TargetBot dentro de este panel.
  HelperThemeButton
    id: remove
    anchors.right: switch.left
    anchors.top: parent.top
    margin-right: 6
    margin-top: 0
    width: 54
    height: 24
    text: Borrar
    tooltip: Eliminar el perfil seleccionado mediante la confirmacion del cliente.
  HelperThemeButton
    id: edit
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 340
    margin-top: 0
    width: 44
    height: 24
    text: JSON
    visible: false
  HelperThemePower
    id: switch
    anchors.top: parent.top
    anchors.right: parent.right
    width: 64
    height: 24
    tooltip: Activa o desactiva este perfil de TargetBot.
    $on:
      text: ON
    $!on:
      text: OFF

