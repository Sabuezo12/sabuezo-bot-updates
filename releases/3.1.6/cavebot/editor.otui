CaveBotWaitStaminaWindow < HelperThemeWindow
  text: Wait stamina
  size: 450 202
  padding: 10

  HelperThemeLabel
    id: maximumTitle
    anchors.left: parent.left
    anchors.top: parent.top
    width: 90
    height: 22
    text: Esperar hasta
    tooltip: Meta obligatoria de stamina. Por defecto 42:00.

  HelperThemeInput
    id: maximum
    anchors.left: maximumTitle.right
    anchors.top: maximumTitle.top
    margin-left: 4
    width: 66
    tooltip: Al llegar a este waypoint espera hasta esta stamina, aunque ya este por encima del minimo anterior. No superar 42:00.

  HelperThemeInput
    id: interval
    anchors.right: parent.right
    anchors.top: parent.top
    width: 54
    tooltip: Segundos entre comprobaciones mientras espera o falta un label. De 0.1 a 3600; admite decimales. No cambia la velocidad de las demas acciones.

  HelperThemeLabel
    id: intervalTitle
    anchors.right: interval.left
    anchors.top: interval.top
    margin-right: 5
    width: 114
    height: 22
    text: Comprobar (s)
    text-align: right

  HelperThemeLabel
    id: readyTitle
    anchors.left: parent.left
    anchors.top: maximumTitle.bottom
    margin-top: 6
    width: 64
    height: 22
    text: Al seguir
    tooltip: Solo se aplica al alcanzar la meta de stamina.

  HelperThemeCombo
    id: readyMode
    anchors.left: readyTitle.right
    anchors.top: readyTitle.top
    margin-left: 5
    width: 166
    tooltip: Al poder continuar, sigue con el proximo waypoint o salta al label elegido. Una espera iniciada solo termina en la maxima.

  HelperThemeCombo
    id: readyLabel
    anchors.left: readyMode.right
    anchors.right: parent.right
    anchors.top: readyMode.top
    margin-left: 6
    tooltip: Destino con stamina suficiente. Los nombres corresponden a los labels de esta ruta; se guardan con el waypoint.

  HelperThemeLabel
    id: help
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: readyTitle.bottom
    margin-top: 8
    height: 32
    text-wrap: true
    text: La ruta permanece en este waypoint hasta alcanzar la meta. Curacion y protecciones siguen activas.

  HelperThemeLabel
    id: feedback
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: help.bottom
    margin-top: 3
    height: 24
    text-wrap: true
    color: #ffcd80

  HelperThemeButton
    id: cancel
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 82
    text: Cancelar

  HelperThemeButton
    id: ok
    anchors.right: cancel.left
    anchors.bottom: parent.bottom
    margin-right: 6
    width: 96
    text: Guardar
    tooltip: Guarda la meta y el destino al terminar. No activa ni desactiva CaveBot.


CaveBotEditorButton < HelperThemeButton
  height: 20
  text-align: center

CaveBotSetProfileCheckBox < HelperThemeToggle
  height: 20
  margin-top: 3

CaveBotDepotModeButton < HelperThemeToggle
  height: 24
  margin-top: 4
  text-align: center

CaveBotDepotActionWindow < HelperThemeWindow
  text: Depot
  width: 320
  height: 235
  padding: 18

  HelperThemeLabel
    id: description
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-align: center
    text-wrap: true
    text-auto-resize: true
    text: Select what this waypoint should do.

  CaveBotDepotModeButton
    id: deposit
    anchors.top: description.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    text: Deposit

  CaveBotDepotModeButton
    id: withdraw
    anchors.top: deposit.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text: Withdraw

  CaveBotDepotModeButton
    id: all
    anchors.top: withdraw.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text: Deposit + Withdraw

  HelperThemeLabel
    id: preview
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: ok.top
    margin-bottom: 10
    height: 32
    text-align: center
    text-wrap: true
    text: -

  HelperThemeButton
    id: ok
    !text: tr('Ok')
    anchors.bottom: parent.bottom
    anchors.right: next.left
    margin-right: 10
    width: 60

  HelperThemeButton
    id: cancel
    !text: tr('Cancel')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 60

CaveBotSetProfileEditorWindow < HelperThemeWindow
  text: Set CaveBot profile
  width: 360
  height: 380
  padding: 18

  HelperThemeLabel
    id: description
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    text-align: center
    text-wrap: true
    text-auto-resize: true
    text: Select one route, or select multiple to choose randomly.

  VerticalScrollBar
    id: profilesScroll
    anchors.top: description.bottom
    anchors.right: parent.right
    anchors.bottom: preview.top
    step: 20
    pixels-scroll: true
    margin-top: 8
    margin-bottom: 8

  HelperThemeScroll
    id: profiles
    anchors.top: description.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: preview.top
    vertical-scrollbar: profilesScroll
    margin-top: 8
    margin-right: 12
    margin-bottom: 8
    padding-right: 2
    layout:
      type: verticalBox

  HelperThemeLabel
    id: preview
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: ok.top
    margin-bottom: 10
    height: 34
    text-align: center
    text-wrap: true
    text: -

  HelperThemeButton
    id: ok
    !text: tr('Ok')
    anchors.bottom: parent.bottom
    anchors.right: next.left
    margin-right: 10
    width: 60

  HelperThemeButton
    id: cancel
    !text: tr('Cancel')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 60


CaveBotEditorPanel < Panel
  id: cavebotEditor
  visible: false
  layout:
    type: verticalBox
    fit-children: true
  
  HelperThemeLabel
    id: pos
    text-align: center
    text: -
    
  Panel
    id: buttons
    margin-top: 2
    layout:
      type: grid
      cell-size: 78 20
      cell-spacing: 1
      num-columns: 2
      fit-children: true

  HelperThemeLabel
    text: Double click on action from action list to edit it
    text-align: center
    text-auto-resize: true
    text-wrap: true
    margin-top: 3
    margin-left: 2
    margin-right: 2
