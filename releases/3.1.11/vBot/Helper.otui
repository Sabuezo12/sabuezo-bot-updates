HelperLauncher < HelperThemeButton
  id: sabuezoHelperIcon
  size: 54 72
  draggable: true
  focusable: false
  padding: 0
  image-source:
  background-color: #00000000
  border-width: 0
  text:
  text-offset: 0 0
  $hover !disabled:
    image-source:
    background-color: #00000000
    text-offset: 0 0
  $pressed:
    image-source:
    background-color: #00000000
    text-offset: 0 0

  UIWidget
    id: emblem
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 54
    image-source: botserver_assets/helper-sabuezo-cyan-suave-46.png
    image-clip: 0 0 46 46
    image-fixed-ratio: true
    image-repeated: false
    image-auto-resize: false
    image-color: #ffffff
    image-smooth: true
    phantom: true
    focusable: false

  Label
    id: state
    visible: true
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 18
    margin-left: 0
    margin-right: 0
    margin-bottom: 0
    text: RBot
    color: #50d7d4
    background-color: #00000000
    text-align: center
    font: verdana-11px-rounded
    phantom: true
    focusable: false

HelperWindow < MainWindow
  id: sabuezoHelperWindow
  text:
  size: 460 500
  image-source:
  background-color: #172126
  border-width: 1
  border-color: #3e515e
  padding: 10
  padding-top: 8
  padding-left: 10
  padding-right: 10
  padding-bottom: 10

  HelperThemeIcon
    id: brand
    anchors.left: parent.left
    anchors.top: parent.top
    size: 24 24

  HelperTitle
    id: title
    anchors.top: parent.top
    anchors.left: brand.right
    anchors.right: reloadBot.left
    margin-left: 6
    margin-right: 6
    height: 24
    color: #edf6fa
    text: RinoBot

  HelperButton
    id: fold
    anchors.top: parent.top
    anchors.right: parent.right
    size: 22 22
    text: X

  HelperButton
    id: expand
    anchors.top: parent.top
    anchors.right: fold.left
    margin-right: 4
    size: 26 22
    text: [ ]

  HelperButton
    id: minimize
    anchors.top: parent.top
    anchors.right: expand.left
    margin-right: 4
    size: 22 22
    text: -

  HelperButton
    id: reloadBot
    anchors.top: parent.top
    anchors.right: minimize.left
    margin-right: 6
    size: 108 22
    padding-left: 0
    padding-right: 3
    text:

    HelperThemeIcon
      id: glyph
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      size: 14 14

    HelperThemeLabel
      id: caption
      anchors.left: glyph.right
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-left: 5
      text: Recargar bot
      text-align: left
      phantom: true
      focusable: false

  HelperLabel
    id: character
    anchors.top: title.bottom
    anchors.left: parent.left
    width: 128
    margin-top: 3
    height: 24
    text: Helper

  HelperSelector
    id: profileList
    anchors.top: character.top
    anchors.left: character.right
    anchors.right: newProfile.left
    margin-left: 6
    margin-right: 4
    height: 22

  HelperButton
    id: newProfile
    anchors.top: character.top
    anchors.right: autoProfile.left
    margin-right: 4
    size: 26 22
    text: +

  HelperButton
    id: autoProfile
    anchors.top: character.top
    anchors.right: parent.right
    size: 44 22
    text: Char

  HelperInput
    id: search
    anchors.top: character.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    margin-top: 4
    placeholder: Buscar funcion o ajuste...
    padding-left: 26

    HelperThemeIcon
      id: glyph
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: -21
      size: 14 14

  Panel
    id: nav
    anchors.top: search.bottom
    anchors.bottom: footer.top
    anchors.left: parent.left
    width: 112
    margin-top: 6
    margin-bottom: 6
    layout:
      type: verticalBox
      spacing: 2

  HelperButton
    id: back
    anchors.top: search.bottom
    anchors.left: nav.right
    width: 48
    margin-left: 6
    margin-top: 6
    text: Inicio

  HelperSelector
    id: selector
    font: verdana-11px-antialised
    color: #e4edf3
    anchors.top: back.top
    anchors.left: back.right
    anchors.right: parent.right
    margin-left: 6
    height: 28

  HelperThemeToggle
    id: cavePower
    anchors.fill: selector
    text: CaveBot
    visible: false

  HelperThemeSectionTitle
    id: sectionTitle
    anchors.fill: selector
    text: Navi
    visible: false
    phantom: true
    focusable: false

  VerticalScrollBar
    id: vertical
    anchors.top: selector.bottom
    anchors.bottom: footer.top
    anchors.right: parent.right
    margin-top: 5
    margin-bottom: 18
    step: 38
    pixels-scroll: true

  HorizontalScrollBar
    id: horizontal
    anchors.left: back.left
    anchors.right: vertical.left
    anchors.bottom: footer.top
    margin-bottom: 6
    height: 10
    step: 40
    pixels-scroll: true

  ScrollablePanel
    id: viewport
    clipping: true
    image-source:
    background-color: #172126
    border-width: 0
    padding: 0
    anchors.top: vertical.top
    anchors.bottom: horizontal.top
    anchors.left: back.left
    anchors.right: vertical.left
    margin-right: 4
    margin-bottom: 3
    vertical-scrollbar: vertical
    horizontal-scrollbar: horizontal

    Panel
      id: host
      image-source:
      background-color: #00000000
      padding: 0
      anchors.top: parent.top
      anchors.left: parent.left
      size: 310 430
      layout:
        type: verticalBox
        fit-children: true
        spacing: 5

      HelperGroup
        id: menu

      HelperGroup
        id: controls

      HelperGroup
        id: forms

  Panel
    id: footer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 52

    HelperLabel
      id: status
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 20
      text: Estados reales

    HelperButton
      id: pause
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 170
      padding-left: 22
      padding-right: 3
      text: Pausar Cave + Target

      HelperThemeIcon
        id: glyph
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: -17
        size: 14 14

    HelperButton
      id: updater
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 125
      padding-left: 22
      padding-right: 3
      text: Updater

      HelperThemeIcon
        id: glyph
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: -17
        size: 14 14

    HelperButton
      id: classicMode
      anchors.right: updater.left
      anchors.bottom: parent.bottom
      margin-right: 6
      width: 112
      padding-left: 22
      padding-right: 3
      text: Modo clasico

      HelperThemeIcon
        id: glyph
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: -17
        size: 14 14

