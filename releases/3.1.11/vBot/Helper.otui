HelperButton < HelperThemeButton
  height: 24

HelperSwitch < HelperThemeSwitch
  HelperThemeLabel
    id: caption
    anchors.fill: parent
    text: OFF
    text-align: center
    phantom: true
    focusable: false

HelperFlatButton < Button
  font: verdana-11px-antialised
  color: #e4edf3
  padding: 0
  text-align: left
  text-offset: 5 0
  image-source:
  image-clip: 0 0 32 32
  image-border: 5
  $hover !disabled:
    image-source: botserver_assets/row-hover.png
    image-clip: 0 0 32 32
    image-border: 5
    text-offset: 5 0
  $pressed:
    image-source: botserver_assets/row-selected.png
    image-clip: 0 0 32 32
    image-border: 5
    text-offset: 5 0

HelperRow < Panel
  height: 36
  margin-bottom: 2
  image-source:
  background-color: #212e37
  border-width: 1
  border-color: #3e515e

  HelperThemeIcon
    id: glyph
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    size: 20 20

  HelperFlatButton
    id: name
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: favorite.left
    margin: 3
    margin-left: 32
    margin-right: 54

  HelperSwitch
    id: power
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: favorite.left
    margin-right: 5

  HelperButton
    id: setup
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: favorite.left
    margin-right: 5
    size: 64 24
    text: Config
    visible: false

  HelperButton
    id: favorite
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    margin-right: 4
    size: 20 24
    text: +

HelperLabel < Label
