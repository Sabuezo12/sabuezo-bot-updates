HelperCaveBotPanel < Panel
  size: 580 234

  HelperThemeSectionTitle
    anchors.left: parent.left
    anchors.right: autoRecording.left
    anchors.top: parent.top
    margin-right: 8
    text: Waypoints de la ruta

  Panel
    id: listPanel
    anchors.left: parent.left
    anchors.right: autoRecording.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-top: 24
    margin-right: 8

    VerticalScrollBar
      id: listScrollbar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      pixels-scroll: true
      step: 20

    HelperThemeList
      id: list
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: listScrollbar.left
      margin-right: 3
      vertical-scrollbar: listScrollbar
      focusable: false
      auto-focus: first

  HelperThemeToggle
    id: autoRecording
    anchors.right: parent.right
    anchors.top: parent.top
    size: 216 22
    text: Grabar ruta

  HelperThemeToggle
    id: showWaypoints
    anchors.left: autoRecording.left
    anchors.right: parent.right
    anchors.top: autoRecording.bottom
    margin-top: 6
    height: 22
    text: Ver waypoints

  HelperThemeSection
    id: autoExplorer
    anchors.left: autoRecording.left
    anchors.right: parent.right
    anchors.top: showWaypoints.bottom
    margin-top: 6
    height: 140
    padding: 5

    HelperThemeToggle
      id: enabled
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      height: 22
      text: Auto Explorer

    Panel
      id: statusRow
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: enabled.bottom
      margin-top: 4
      height: 20

      HelperThemeInput
        id: radiusEdit
        anchors.right: parent.right
        anchors.top: parent.top
        size: 38 20

      HelperThemeLabel
        id: perimeterLabel
        text: Radio
        anchors.right: radiusEdit.left
        anchors.verticalCenter: parent.verticalCenter
        width: 34
        margin-right: 4

      HelperThemeLabel
        id: statusLabel
        text: Off
        anchors.left: parent.left
        anchors.right: perimeterLabel.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 5

    Panel
      id: perimeterRow
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: statusRow.bottom
      margin-top: 3
      height: 16

      HorizontalScrollBar
        id: perimeterSlider
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        minimum: 20
        maximum: 120
        step: 1

    Panel
      id: optionsRow
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: perimeterRow.bottom
      margin-top: 3
      height: 50

      HelperThemePower
        id: previewSwitch
        anchors.left: parent.left
        anchors.top: parent.top
        size: 104 22
        $on:
          text: Ver radio ON
        $!on:
          text: Ver radio OFF

      HelperThemeButton
        id: resetButton
        anchors.left: previewSwitch.right
        anchors.right: parent.right
        anchors.top: parent.top
        margin-left: 5
        height: 22
        text: Limpiar

      HelperThemePower
        id: floorSwitch
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: previewSwitch.bottom
        margin-top: 5
        height: 22
        $on:
          text: Mismo piso ON
        $!on:
          text: Mismo piso OFF

  HelperThemePower
    id: showEditor
    anchors.left: autoRecording.left
    anchors.top: autoExplorer.bottom
    margin-top: 6
    size: 105 22
    visible: false
    enabled: false

  HelperThemeButton
    id: showConfig
    anchors.left: autoRecording.left
    anchors.right: parent.right
    anchors.top: autoExplorer.bottom
    margin-top: 6
    height: 22
    text: Configuracion

HelperCaveEditorPanel < HelperThemeSection
  id: cavebotEditor
  width: 580
  visible: true
  padding: 5
  layout:
    type: verticalBox
    fit-children: true
    spacing: 3

  HelperThemeLabel
    id: pos
    height: 18
    text: -
    color: #50d7d4

  Panel
    id: buttons
    layout:
      type: grid
      cell-size: 104 22
      cell-spacing: 3
      flow: true
      fit-children: true

  HelperThemeLabel
    height: 16
    text: Doble clic en un waypoint para editarlo.
    color: #a9bbc6

HelperFloatingPanel < MainWindow
  text:
  size: 620 470
  image-source:
  background-color: #172126
  border-width: 1
  border-color: #3e515e
  padding: 8
  padding-top: 8
  padding-left: 8
  padding-right: 8
  padding-bottom: 8

  HelperThemeIcon
    id: glyph
    anchors.left: parent.left
    anchors.top: parent.top
    size: 22 22

  HelperTitle
    id: heading
    anchors.top: parent.top
    anchors.left: glyph.right
    anchors.right: closeButton.left
    margin-left: 6
    margin-right: 8
    height: 22

  HelperButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    size: 22 22
    text: X

  VerticalScrollBar
    id: vertical
    anchors.top: heading.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 8
    margin-bottom: 18
    step: 30
    pixels-scroll: true

  HorizontalScrollBar
    id: horizontal
    anchors.left: parent.left
    anchors.right: vertical.left
    anchors.bottom: parent.bottom
    height: 10
    margin-right: 4
    step: 30
    pixels-scroll: true

  ScrollablePanel
    id: viewport
    clipping: true
    anchors.top: vertical.top
    anchors.bottom: horizontal.top
    anchors.left: parent.left
    anchors.right: vertical.left
    margin-right: 4
    margin-bottom: 4
    image-source:
    background-color: #172126
    vertical-scrollbar: vertical
    horizontal-scrollbar: horizontal
    padding: 0

    HelperGroup
      id: host
      anchors.top: parent.top
      anchors.left: parent.left
      width: 580

HelperFoodSection < HelperGroup
  width: 500
  padding: 5
  background-color: #25333d
  border-width: 1
  border-color: #58717e

  Panel
    id: header
    height: 22

    HelperHeading
      id: heading
      anchors.left: parent.left
      anchors.right: conjure.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      text: Comida

    HelperThemeCheck
      id: conjure
      anchors.right: power.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 12
      size: 140 18
      text: Conjurar comida
      tooltip: Permite exevo pan solo si lo marcas y Comida esta ON. Inicialmente desactivado.

    HelperSwitch
      id: power
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      tooltip: Activar comer alimentos. Solo conjura si marcas Conjurar comida; OFF detiene ambas funciones.


