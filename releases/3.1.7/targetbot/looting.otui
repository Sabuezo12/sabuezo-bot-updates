TargetBotLootingPanel < Panel
  width: 820
  height: 306
  anchors.fill: parent
  HelperThemeLabel
    id: ignoredTitle
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 6
    margin-top: 2
    width: 246
    height: 20
    text: Criaturas ignoradas
    color: #50d7d4
  Panel
    id: ignoreCreaturesPanel
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 6
    margin-top: 28
    width: 246
    height: 204
    HelperThemeList
      id: ignoreCreaturesList
      anchors.fill: parent
      margin-right: 12
      vertical-scrollbar: ignoreCreaturesScrollbar
      focusable: false
      auto-focus: first
    VerticalScrollBar
      id: ignoreCreaturesScrollbar
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 10
      pixels-scroll: true
      step: 15
  Panel
    id: ignoreCreaturesButtons
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 6
    margin-top: 238
    width: 246
    height: 24
    HelperThemeButton
      id: add
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 0
      margin-top: 0
      width: 78
      height: 22
      text: Agregar
    HelperThemeButton
      id: edit
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 84
      margin-top: 0
      width: 78
      height: 22
      text: Editar
    HelperThemeButton
      id: remove
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 168
      margin-top: 0
      width: 78
      height: 22
      text: Quitar
  HelperThemeLabel
    id: itemsTitle
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 270
    margin-top: 2
    width: 538
    height: 20
    text: Objetos a recoger
    color: #50d7d4
  BotContainer
    id: items
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 270
    margin-top: 28
    width: 538
    height: 84
  HelperThemePower
    id: everyItem
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 270
    margin-top: 116
    width: 538
    height: 22
    text: Recoger todos los objetos
    $on:
      text: Recoger todos los objetos: ON
    $!on:
      text: Recoger todos los objetos: OFF
  HelperThemeLabel
    id: containersTitle
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 270
    margin-top: 144
    width: 538
    height: 18
    text: Mochilas para loot
    color: #50d7d4
  BotContainer
    id: containers
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 270
    margin-top: 166
    width: 538
    height: 38
  Panel
    id: maxDangerPanel
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 270
    margin-top: 214
    width: 262
    height: 24
    HelperThemeLabel
      id: label
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 0
      margin-top: 0
      width: 170
      height: 22
      text: Peligro maximo
    HelperThemeInput
      id: value
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 174
      margin-top: 0
      width: 80
      height: 22
  Panel
    id: minCapacityPanel
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 546
    margin-top: 214
    width: 262
    height: 24
    HelperThemeLabel
      id: label
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 0
      margin-top: 0
      width: 170
      height: 22
      text: Capacidad minima
    HelperThemeInput
      id: value
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 174
      margin-top: 0
      width: 80
      height: 22
  HelperThemeLabel
    id: help
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 6
    margin-top: 274
    width: 802
    height: 26
    text: Este loot es general. Se guarda al ajustar cada control; no cambia el borrador de criaturas.
    font: verdana-9px
    text-wrap: true
    color: #c0cdd6
