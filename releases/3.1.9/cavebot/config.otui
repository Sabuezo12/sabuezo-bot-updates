CaveBotConfigNumberValuePanel < Panel
  height: 26
  margin-top: 4

  HelperThemeInput
    id: value
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 70

  HelperThemeLabel
    id: title
    anchors.left: parent.left
    anchors.right: value.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    height: 18
    text-align: left

CaveBotConfigBooleanValuePanel < Panel
  height: 26
  margin-top: 4

  HelperThemePower
    id: value
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 70

    $on:
      text: On

    $!on:
      text: Off

  HelperThemeLabel
    id: title
    anchors.left: parent.left
    anchors.right: value.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    height: 18
    text-align: left

