HelperThemeButton < Button
  font: verdana-11px-antialised
  color: #e4edf3
  height: 22
  padding: 0
  text-offset: 0 0
  image-source:
  background-color: #263640
  border-width: 1
  border-color: #3e515e
  $hover !disabled:
    image-source:
    background-color: #304650
    text-offset: 0 0
  $pressed:
    image-source:
    background-color: #1d5359
    text-offset: 0 0
  $on:
    image-source:
    background-color: #18434a
    border-color: #50d7d4
    color: #dcffff
  $disabled:
    image-source:
    opacity: 0.45

HelperThemeSwitch < HelperThemeButton
  size: 44 18
  height: 18
  padding: 0
  text:
  background-color: #212e37

  UIWidget
    id: rinoKnob
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    size: 12 12
    image-source: rpg_assets/knob.png
    image-color: #f0f7f9
    image-smooth: true
    phantom: true
    focusable: false

HelperThemeIcon < UIWidget
  size: 20 20
  image-fixed-ratio: true
  image-auto-resize: false
  image-smooth: true
  phantom: true
  focusable: false

// Static native forms retain their original dimensions and padding.
HelperRpgButton < Button
  image-source:
  background-color: #263640
  border-width: 1
  border-color: #3e515e
  color: #e4edf3
  $hover !disabled:
    background-color: #304650
  $pressed:
    background-color: #18434a
  $on:
    background-color: #18434a

