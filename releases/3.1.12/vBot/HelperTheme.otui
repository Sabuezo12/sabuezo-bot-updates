    image-source:
    background-color: #18434a
    color: #dcffff
  $pressed:
    image-source:
    background-color: #18434a
    color: #dcffff

HelperThemeCombo < ComboBox
  font: verdana-11px-antialised
  color: #e4edf3
  height: 22
  image-source:
  image-border: 0
  background-color: #0f1920
  border-width: 1
  border-color: #6a8492
  padding: 4

  HelperThemeLabel
    id: rinoArrow
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    size: 10 16
    text: v
    text-align: center
    phantom: true

  $hover:
    image-source:
    border-color: #50d7d4
  $pressed:
    image-source:
    background-color: #18434a

  $on:
    image-source:
    image-border: 0
    background-color: #18434a
    border-color: #50d7d4
    color: #dcffff
  $disabled:
    image-source:
    image-border: 0
    opacity: 0.45

HelperThemeCheck < CheckBox
  font: verdana-11px-antialised
  color: #e4edf3

HelperThemeWindow < MainWindow
  image-source:
  background-color: #172126
  border-width: 0
  padding: 8
  padding-top: 10
  font: verdana-11px-antialised
  color: #e4edf3

HelperThemeToggle < BotSwitch
  height: 30
  image-source:
  background-color: #00000000
  border-width: 0
  text:
  $on:
    image-source:
    background-color: #00000000
  $off:
    image-source:
    background-color: #00000000
  $hover:
    image-source:
    background-color: #263640
  $pressed:
    image-source:
    text-offset: 0 0
  HelperThemeLabel
    id: helperCaption
    anchors.left: parent.left
    anchors.right: helperTrack.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 8
    height: 22
    text-align: left
    text-wrap: false
    phantom: true
  HelperThemeSwitch
    id: helperTrack
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    phantom: true
    focusable: false
    HelperThemeLabel
      id: helperState
      anchors.fill: parent
      text: OFF
      text-align: center
      phantom: true
      focusable: false

HelperThemePower < HelperThemeButton
  height: 20

