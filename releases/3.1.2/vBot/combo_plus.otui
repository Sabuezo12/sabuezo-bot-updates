ComboPlusScrollBar < Panel
  height: 28
  margin-top: 4

  UIWidget
    id: text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center

  HorizontalScrollBar
    id: scroll
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    minimum: 0
    maximum: 10
    step: 1

ComboPlusTextEdit < Panel
  height: 38
  margin-top: 5

  UIWidget
    id: text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center

  HelperThemeInput
    id: textEdit
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    font: verdana-11px-antialised
    text-align: center

ComboPlusItem < Panel
  height: 34
  margin-top: 6
  margin-left: 18
  margin-right: 18

  UIWidget
    id: text
    anchors.verticalCenter: next.verticalCenter
    anchors.left: parent.left

  BotItem
    id: item
    anchors.top: parent.top
    anchors.right: parent.right

ComboPlusCheckBox < HelperThemeToggle
  height: 20
  margin-top: 6

ComboPlusModeRow < Panel
  height: 42
  margin-top: 6

  UIWidget
    id: text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center

  HelperThemePower
    id: autoButton
    anchors.top: prev.bottom
    anchors.left: parent.left
    width: 82
    height: 18
    margin-top: 4
    text-align: center
    text: Auto

  HelperThemePower
    id: halfButton
    anchors.top: autoButton.top
    anchors.left: autoButton.right
    anchors.right: parent.right
    height: 18
    margin-left: 4
    text-align: center
    text: Half Circle

ComboPlusSection < UIWidget
  height: 18
  margin-top: 8
  font: verdana-11px-antialised
  color: #ffaa00
  text-align: center

ComboPlusWindow < HelperThemeWindow
  !text: tr('by:Sabuezo')
  size: 460 420
  padding: 25

  HelperThemeLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    text: Combo
    color: #ffaa00
    text-align: center

  HelperThemeLabel
    anchors.top: parent.top
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    text: Magic Wall
    color: #ffaa00
    text-align: center

  VerticalScrollBar
    id: contentScroll
    anchors.top: prev.bottom
    anchors.bottom: separator.top
    anchors.right: parent.right
    margin-top: 6
    margin-bottom: 8
    margin-right: -10
    step: 28
    pixels-scroll: true

  HelperThemeScroll
    id: content
    anchors.top: contentScroll.top
    anchors.bottom: contentScroll.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    vertical-scrollbar: contentScroll

    HelperThemeSection
      id: left
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      margin-left: 8
      margin-right: 10
      layout:
        type: verticalBox
        fit-children: true

    HelperThemeSection
      id: right
      anchors.top: parent.top
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      margin-left: 10
      margin-right: 8
      layout:
        type: verticalBox
        fit-children: true

    HelperThemeVerticalDivider
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.horizontalCenter

  HelperThemeDivider
    id: separator
    anchors.bottom: closeButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8

  HelperThemeButton
    id: closeButton
    !text: tr('Close')
    size: 45 21
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 5
    font: verdana-11px-antialised
