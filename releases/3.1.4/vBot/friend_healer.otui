CategoryCheckBox < HelperThemeCheck
  height: 13
  font: verdana-11px-antialised 
  margin-top: 0

  $checked:
    color: #98BF64

HealScroll < Panel

  ToolTipLabel
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    font: verdana-9px
    height: 11
    width: 134
    id: text
    text-align: center
    text: test
    
  HorizontalScrollBar
    margin-top: 13
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 9
    width: 134
    id: scroll
    minimum: 0
    maximum: 100
    step: 1

HealItem < Panel

  BotItem
    margin-top: 1
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 20
    width: 20
    id: item

  ToolTipLabel
    margin-top: 0
    margin-left: 24
    anchors.top: parent.top
    anchors.left: parent.left
    height: 22
    width: 110
    id: text
    text-wrap: true
    text-align: left

ToolTipLabel < UIWidget
  font: verdana-11px-antialised
  color: #dfdfdf
  height: 14
  text-align: center 

HealerPlayerEntry < HelperThemeLabel
  background-color: alpha
  text-offset: 5 1
  focusable: true
  height: 18
  font: verdana-11px-antialised
  text-align: left

  $focus:
    background-color: #00000055
  
  HelperThemeButton
    margin-right: 2
    id: remove
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    size: 14 14
    text: X
    tooltip: Remove player from the list

PriorityEntry < ToolTipLabel
  background-color: alpha
  text-offset: 18 1
  focusable: true
  height: 15
  font: verdana-11px-antialised
  text-align: left

  $focus:
    background-color: #00000055

  HelperThemeCheck
    id: enabled
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 14 14
    margin-top: 0
    margin-left: 3 
  
  HelperThemeButton
    id: increment
    anchors.right: parent.right
    margin-right: 2
    anchors.verticalCenter: parent.verticalCenter
    size: 14 14
    text: +
    tooltip: Increase Priority

  HelperThemeButton
    id: decrement
    anchors.right: prev.left
    margin-right: 2
    anchors.verticalCenter: parent.verticalCenter
    size: 14 14
    text: -
    tooltip: Decrease Priority

TargetSettings < HelperThemeSection
  size: 278 110
  padding: 4

  HelperThemeLabel
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 12
    width: 270
    id: heading
    font: verdana-11px-antialised 
    text: Heal Target Settings

  Groups
    margin-top: 14
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 88
    width: 140
    id: groups

  Vocations
    margin-top: 14
    margin-left: 146
    anchors.top: parent.top
    anchors.left: parent.left
    height: 88
    width: 124
    id: vocations

Groups < HelperThemeCard
  size: 140 88
  padding: 3
  padding-top: 3

  ToolTipLabel
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 12
    width: 134
    id: title
    text: Groups
    tooltip: Players added in custom list will always be in scope

  HelperThemeDivider
    margin-top: 14
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 1
    width: 134
    id: divider

  Panel
    margin-top: 16
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 66
    width: 134
    id: box
    padding: 0
    layout: 
      type: verticalBox

    CategoryCheckBox
      id: friends
      text: Friends

    CategoryCheckBox
      id: party
      text: Party Members

    CategoryCheckBox
      id: guild
      text: Guild Members

    CategoryCheckBox
      id: botserver
      text: BotServer Members
  
Vocations < HelperThemeCard
  size: 124 88
  padding: 3
  padding-top: 3

  ToolTipLabel
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 12
    width: 118
    id: title
    font: verdana-11px-antialised 
    text: Vocations

  HelperThemeDivider
    margin-top: 14
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 1
    width: 118
    id: divider

  Panel
    margin-top: 16
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 66
    width: 118
    id: box
    padding: 0

    layout: 
      type: verticalBox

    CategoryCheckBox
      id: knights
      text: Knights

    CategoryCheckBox
      id: paladins
      text: Paladins

    CategoryCheckBox
      id: druids
      text: Druids

    CategoryCheckBox
      id: sorcerers
      text: Sorcerers

    CategoryCheckBox
      id: monks
      text: Monks
      tooltip: Monk and Exalted Monk.

Priority < HelperThemeSection
  size: 184 116
  padding: 4
  padding-top: 4

  ToolTipLabel
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 12
    width: 176
    id: title
    font: verdana-11px-antialised 
    text: Priority & Toggles

  HelperThemeList
    margin-top: 16
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    padding: 0
    height: 92
    width: 176
    id: list
    fit-children: false
    padding-top: 0

AddPlayer < HelperThemeCard
  padding: 2

  HelperThemeLabel
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 20
    width: 172
    id: heading
    font: verdana-9px
    text: Add Player to Custom List
    text-align: center
    text-wrap: true

  HelperThemeDivider
    margin-top: 22
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 1
    width: 172
    id: divider

  HelperThemeSpin
    margin-top: 26
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 18
    id: health
    width: 44
    minimum: 1
    maximum: 99
    step: 1
    focusable: true
    text-align: center

  HelperThemeLabel
    margin-top: 26
    margin-left: 48
    anchors.top: parent.top
    anchors.left: parent.left
    height: 18
    width: 124
    id: hpLabel
    font: verdana-9px
    text: %HP - heal if below

  HelperThemeInput
    margin-top: 48
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 20
    width: 172
    id: name
    font: verdana-11px-antialised 
    text-align: center
    text: friend name

  HelperThemeButton
    margin-top: 72
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 20
    width: 172
    id: add
    font: verdana-11px-antialised 
    text: Add Player

PlayerList < Panel

  HelperThemeList
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    padding: 2
    height: 104
    width: 160
    id: list
    fit-children: false
    padding-top: 2
    vertical-scrollbar: listScrollBar

  VerticalScrollBar
    margin-top: 0
    margin-left: 164
    anchors.top: parent.top
    anchors.left: parent.left
    height: 104
    width: 12
    id: listScrollBar
    step: 14
    pixels-scroll: true

CustomList < HelperThemeSection
  size: 184 128
  padding: 4
  padding-top: 4

  ToolTipLabel
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 12
    width: 176
    id: heading
    font: verdana-11px-antialised 
    text: Custom Player List
    tooltip: Double click on the list below to add new player.

  AddPlayer
    margin-top: 16
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 104
    width: 176
    id: addPanel

  PlayerList
    margin-top: 16
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 104
    width: 176
    id: playerList

Conditions < HelperThemeSection
  size: 278 140
  padding: 4

  HelperThemeLabel
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 12
    width: 270
    id: heading
    font: verdana-11px-antialised 
    text: Player Conditions

  Panel
    margin-top: 14
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 118
    width: 270
    id: box
    padding: 0
    padding-top: 0
    layout: 
      type: grid
      cell-size: 134 22
      cell-spacing: 2
      num-columns: 2

FriendHealer < HelperThemeWindow
  padding-bottom: 6
  !text: tr('Friend Healer')
  size: 484 296
  padding-top: 6
  @onEscape: self:hide()

  Conditions
    margin-top: 0
    margin-left: 190
    anchors.top: parent.top
    anchors.left: parent.left
    height: 140
    width: 278
    id: conditions

  TargetSettings
    margin-top: 146
    margin-left: 190
    anchors.top: parent.top
    anchors.left: parent.left
    height: 110
    width: 278
    id: targetSettings

  Priority
    margin-top: 0
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 116
    width: 184
    id: priority

  CustomList
    margin-top: 122
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 128
    width: 184
    id: customList

  HelperThemeDivider
    margin-top: 258
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 1
    width: 468
    id: separator

  HelperThemeButton
    margin-top: 264
    margin-left: 404
    anchors.top: parent.top
    anchors.left: parent.left
    height: 20
    width: 64
    id: closeButton
    !text: tr('Close')
    font: verdana-11px-antialised
    @onClick: self:getParent():hide()    

  HelperThemePower
    margin-top: 264
    margin-left: 0
    anchors.top: parent.top
    anchors.left: parent.left
    height: 20
    width: 136
    id: sCheckRL
    !text: tr('Check RL Conditions')
    font: verdana-11px-antialised  
